# ============================================================
# Dockerfile.env — ROS2 Humble 导航环境镜像（不含业务代码）
# ============================================================
# 从 ros:humble-ros-base 构建完整开发环境。
# 代码通过 volume 挂载，容器内 colcon build。
#
# 构建：docker compose -f docker/compose.build.yml build
# ============================================================

ARG ROS_DISTRO=humble

ARG http_proxy=
ARG https_proxy=
ARG no_proxy=
ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ARG NO_PROXY=

FROM ros:${ROS_DISTRO}-ros-base

ARG ROS_DISTRO=humble

ARG http_proxy=
ARG https_proxy=
ARG no_proxy=
ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ARG NO_PROXY=

SHELL ["/bin/bash", "-lc"]
ENV DEBIAN_FRONTEND=noninteractive
ENV http_proxy=${http_proxy} \
    https_proxy=${https_proxy} \
    no_proxy=${no_proxy} \
    HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY}

ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=graphics,display,utility,compute

WORKDIR /ws

# ---------- apt 镜像源（可选） ----------
ARG APT_MIRROR=
RUN if [[ -n "${APT_MIRROR}" ]]; then \
      sed -i \
        -e "s|http://archive.ubuntu.com/ubuntu|http://${APT_MIRROR}/ubuntu|g" \
        -e "s|http://security.ubuntu.com/ubuntu|http://${APT_MIRROR}/ubuntu|g" \
        /etc/apt/sources.list; \
    fi

# ---------- OSRF Gazebo apt 源 ----------
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl gnupg lsb-release \
  && curl -sSL https://packages.osrfoundation.org/gazebo.gpg \
       -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) \
       signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] \
       http://packages.osrfoundation.org/gazebo/ubuntu-stable \
       $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
       > /etc/apt/sources.list.d/gazebo-stable.list \
  && rm -rf /var/lib/apt/lists/*

# ---------- 系统依赖 & ROS 包 ----------
RUN if [[ -n "${APT_MIRROR}" ]]; then \
      export no_proxy="${no_proxy:+${no_proxy},}${APT_MIRROR}"; \
      export NO_PROXY="${NO_PROXY:+${NO_PROXY},}${APT_MIRROR}"; \
    fi \
  && apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ccache git curl wget software-properties-common \
    python3-pip python3-venv python3-dev python3-packaging python3-setuptools \
    python3-pkg-resources python3-yaml python3-colcon-common-extensions \
    python3-rosdep python3-tk \
    ros-${ROS_DISTRO}-example-interfaces \
    libpcl-dev libeigen3-dev libomp-dev \
    libgl1-mesa-dev libgles2-mesa-dev libegl1-mesa-dev \
    mesa-utils xvfb xterm xclip xsel fonts-noto-cjk fonts-wqy-microhei \
    ros-${ROS_DISTRO}-navigation2 ros-${ROS_DISTRO}-nav2-common \
    ros-${ROS_DISTRO}-nav2-core ros-${ROS_DISTRO}-nav2-util \
    ros-${ROS_DISTRO}-nav2-costmap-2d ros-${ROS_DISTRO}-nav2-msgs \
    ros-${ROS_DISTRO}-nav2-behavior-tree ros-${ROS_DISTRO}-nav2-behaviors \
    ros-${ROS_DISTRO}-slam-toolbox ros-${ROS_DISTRO}-laser-geometry \
    ros-${ROS_DISTRO}-cv-bridge ros-${ROS_DISTRO}-camera-info-manager \
    ros-${ROS_DISTRO}-image-transport \
    ros-${ROS_DISTRO}-rviz2 ros-${ROS_DISTRO}-rqt \
    ros-${ROS_DISTRO}-rqt-common-plugins ros-${ROS_DISTRO}-rqt-publisher \
    ros-${ROS_DISTRO}-rqt-tf-tree ros-${ROS_DISTRO}-rqt-graph \
    ros-${ROS_DISTRO}-rqt-topic ros-${ROS_DISTRO}-rqt-reconfigure \
    ros-${ROS_DISTRO}-plotjuggler-ros \
    ros-${ROS_DISTRO}-ros-gz-bridge ros-${ROS_DISTRO}-ros-gz-sim \
    ros-${ROS_DISTRO}-behaviortree-cpp ros-${ROS_DISTRO}-xacro \
    ros-${ROS_DISTRO}-joy \
    ros-${ROS_DISTRO}-ament-cmake-clang-format \
    ros-${ROS_DISTRO}-ament-cmake-black \
    ros-${ROS_DISTRO}-ament-cmake-clang-tidy \
    libignition-msgs8-dev libignition-transport11-dev \
    libunwind-dev libgoogle-glog-dev libcurl4-openssl-dev \
    libjsoncpp-dev libopencv-dev libasio-dev libusb-1.0-0-dev \
    usbutils vim nano \
  && rm -rf /var/lib/apt/lists/*

# ---------- rosdep ----------
RUN rosdep init 2>/dev/null || true && rosdep update

COPY docker/rosdep_src/ /tmp/rosdep_src/

RUN if [[ -n "${APT_MIRROR}" ]]; then \
      export no_proxy="${no_proxy:+${no_proxy},}${APT_MIRROR}"; \
      export NO_PROXY="${NO_PROXY:+${NO_PROXY},}${APT_MIRROR}"; \
    fi \
  && apt-get update \
  && source /opt/ros/${ROS_DISTRO}/setup.bash \
  && rosdep install -r --from-paths /tmp/rosdep_src --ignore-src \
     --rosdistro ${ROS_DISTRO} -y \
     --skip-keys auto_aim_interfaces \
  && rm -rf /var/lib/apt/lists/* /tmp/rosdep_src

# ---------- small_gicp ----------
COPY src/small_gicp/ /tmp/small_gicp_src/

RUN cmake -S /tmp/small_gicp_src -B /tmp/small_gicp_build \
      -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_HELPER=ON \
      -DBUILD_TESTS=OFF \
      -DBUILD_EXAMPLES=OFF \
      -DBUILD_BENCHMARKS=OFF \
      -DBUILD_PYTHON_BINDINGS=OFF \
      -DCMAKE_BUILD_PARALLEL_LEVEL="$(nproc)" \
  && cmake --build /tmp/small_gicp_build \
  && cmake --install /tmp/small_gicp_build \
  && rm -rf /tmp/small_gicp_src /tmp/small_gicp_build

# ---------- Python 工具 ----------
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

RUN pip3 install --no-cache-dir \
      -i ${PIP_INDEX_URL} --trusted-host ${PIP_TRUSTED_HOST} \
      xmacro

# ---------- udev rules ----------
RUN mkdir -p /etc/udev/rules.d \
  && echo 'SUBSYSTEM=="usb", ATTR{idVendor}=="2207", ATTR{idProduct}=="0019", MODE="0666", GROUP="plugdev"' \
     > /etc/udev/rules.d/99-odin-usb.rules

# ---------- entrypoint ----------
COPY docker/ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
