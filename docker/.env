# docker/.env — compose 默认环境变量
# compose.build.yml 和 compose.dev.yml 会自动读取本文件
#
# 改名或切换账号：只需修改本文件，其他文件不用动
# 第一次 push 时 Docker Hub 会自动创建仓库（不需要提前建好）

DOCKERHUB_NS=alphabet2006
IMAGE_REPO=gxu2026-nav-env
IMAGE_TAG=latest

# 开发容器用户映射（右键 Compose Up 直接生效）
LOCAL_UID=1000
LOCAL_GID=1000

# X11 鉴权文件（由 scripts/systemd/gxu2026-docker-xauth.service 自动维护）
XAUTH_HOST_FILE=/tmp/.docker.xauth

# 构建时代理（network: host 模式下 127.0.0.1 = 宿主机）
# 用于 rosdep update / pip install 等 RUN 步骤访问外网
# 如果不需要代理就注释掉
http_proxy=http://127.0.0.1:7897
https_proxy=http://127.0.0.1:7897
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
