                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="是否处于危险状态&#xa;阵亡 或 当前血量小于180" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
