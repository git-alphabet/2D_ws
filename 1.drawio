                <mxCell id="n0" value="开始&#xa;每一轮都从这里判断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="3900" y="110" width="420" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="现在是比赛时间吗&lt;br&gt;判定比赛阶段=4 且 剩余时间0到420秒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
