                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="legend3" value="关键阈值总表&lt;br&gt;低血线180&lt;br&gt;安全血线280&lt;br&gt;低弹线80&lt;br&gt;到达半径0.8米&lt;br&gt;基地危险触发敌人进5米且基地掉血&lt;br&gt;基地危险解除连续30秒平静&lt;br&gt;补弹等待超时30秒&lt;br&gt;主指令频率5赫兹&lt;br&gt;非比赛待机频率2赫兹&lt;br&gt;导航目标下发1赫兹&lt;br&gt;姿态降级阈值180秒；强制维持5秒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#333333;fontSize=14;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
                    <mxGeometry x="4830" y="130" width="1170" height="290" as="geometry"/>
