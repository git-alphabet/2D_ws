                <mxCell id="n11" value="局势稳定，开始运营控图&lt;br&gt;去战略点并巡逻&lt;br&gt;每秒下发一次导航目标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1">
