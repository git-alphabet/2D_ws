                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n8" value="基地拉警报，马上回防&lt;br&gt;先回防守点&lt;br&gt;每秒下发一次守家目标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="3060" y="965" width="480" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n9" value="弹药低于80吗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="3990" y="980" width="420" height="95" as="geometry"/>
