                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="血线告急，马上保命&lt;br&gt;阵亡就原地等复活&lt;br&gt;低血回补给，回血到280再出发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="2630" y="402.5" width="520" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="是否发现敌人" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
