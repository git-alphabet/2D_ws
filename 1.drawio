                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="敌人贴脸，立刻反打&lt;br&gt;立即停车对抗（问题：减速带区域导航不会停止，如果切换姿态是否影响过减速带，理论上不会，因为改的是上限）&lt;br&gt;切到火力优先姿态1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="2670" y="662.5" width="460" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n7" value="基地有危险吗&lt;br&gt;触发敌人进5米且基地掉血&lt;br&gt;解除连续30秒平静" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
