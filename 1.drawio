                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n10" value="弹仓见底，火速补弹&lt;br&gt;去补给点补弹，超时30秒就换策略&lt;br&gt;阈值变化80到半弹到1到放弃" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1">
