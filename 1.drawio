    <diagram id="binary_decision_tree" name="二分树阈值解说版">
        <mxGraphModel dx="500" dy="495" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="9800" pageHeight="7600" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
