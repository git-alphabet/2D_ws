# ============================================================
# Dockerfile.env — 纯依赖环境镜像（不含代码编译）
# ============================================================
# 用途：打包系统依赖（apt / rosdep / small_gicp / neupan venv），
#       代码通过 volume 挂载，容器内执行 colcon build。
#
# 包含：
#   - ROS2 Humble
#   - Ignition Fortress (ros-humble-ros-gz-sim/bridge)
#   - OpenGL/EGL 渲染库（供 Gazebo GPU 渲染）
#   - NVIDIA GPU 透传（NVIDIA_DRIVER_CAPABILITIES=graphics,compute,display）
#   - small_gicp（预编译系统库）
#   - NeuPAN Python venv（CPU torch）
#
# 构建镜像：  ./docker/build_env.sh
# 启动开发容器：./docker/run_dev.sh
# 宿主机前提：nvidia-container-toolkit 已安装，xhost +local:docker
# ============================================================

ARG ROS_DISTRO=humble

ARG http_proxy=
ARG https_proxy=
ARG no_proxy=
ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ARG NO_PROXY=

FROM ros:${ROS_DISTRO}-ros-base

ARG ROS_DISTRO=humble

ARG http_proxy=
ARG https_proxy=
ARG no_proxy=
ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ARG NO_PROXY=

SHELL ["/bin/bash", "-lc"]
ENV DEBIAN_FRONTEND=noninteractive
ENV http_proxy=${http_proxy} \
    https_proxy=${https_proxy} \
    no_proxy=${no_proxy} \
    HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY}

# NVIDIA Container Toolkit：声明需要的 GPU 能力
# graphics = OpenGL/Vulkan 渲染（Gazebo）
# compute  = CUDA 计算
# display  = X11/EGL 显示输出
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=graphics,compute,display,utility

WORKDIR /ws

# ---------- 可选：切换 apt 镜像源（国内加速） ----------
# 用法：--build-arg APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
ARG APT_MIRROR=
RUN if [[ -n "${APT_MIRROR}" ]]; then \
      sed -i \
        -e "s|http://archive.ubuntu.com/ubuntu|http://${APT_MIRROR}/ubuntu|g" \
        -e "s|http://security.ubuntu.com/ubuntu|http://${APT_MIRROR}/ubuntu|g" \
        /etc/apt/sources.list; \
    fi

# ---------- OSRF Gazebo apt 源（ignition-fortress / ros-gz 需要）----------
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl gnupg lsb-release \
  && curl -sSL https://packages.osrfoundation.org/gazebo.gpg \
       -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] \
       http://packages.osrfoundation.org/gazebo/ubuntu-stable \
       $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
       > /etc/apt/sources.list.d/gazebo-stable.list \
  && rm -rf /var/lib/apt/lists/*

# ---------- 构建工具 & Python 工具链 ----------
RUN if [[ -n "${APT_MIRROR}" ]]; then \
      export no_proxy="${no_proxy:+${no_proxy},}${APT_MIRROR}"; \
      export NO_PROXY="${NO_PROXY:+${NO_PROXY},}${APT_MIRROR}"; \
    fi \
  && apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    curl \
    wget \
    python3-pip \
    python3-venv \
    python3-dev \
    python3-colcon-common-extensions \
    python3-rosdep \
    ros-${ROS_DISTRO}-example-interfaces \
    libpcl-dev \
    libeigen3-dev \
    libomp-dev \
    python3-tk \
    libgl1-mesa-dev \
    libgles2-mesa-dev \
    libegl1-mesa-dev \
    mesa-utils \
    xvfb \
    xterm \
    xclip \
    xsel \
    fonts-noto-cjk \
    fonts-wqy-microhei \
    ros-${ROS_DISTRO}-behaviortree-cpp \
    ros-${ROS_DISTRO}-pcl-ros \
    ros-${ROS_DISTRO}-pcl-conversions \
    ros-${ROS_DISTRO}-ros-gz-bridge \
    ros-${ROS_DISTRO}-ros-gz-sim \
    ros-${ROS_DISTRO}-navigation2 \
    ros-${ROS_DISTRO}-nav2-common \
    ros-${ROS_DISTRO}-nav2-core \
    ros-${ROS_DISTRO}-nav2-util \
    ros-${ROS_DISTRO}-nav2-costmap-2d \
    ros-${ROS_DISTRO}-nav2-msgs \
    ros-${ROS_DISTRO}-nav2-behavior-tree \
    ros-${ROS_DISTRO}-nav2-behaviors \
    ros-${ROS_DISTRO}-slam-toolbox \
    ros-${ROS_DISTRO}-laser-geometry \
    ros-${ROS_DISTRO}-cv-bridge \
    ros-${ROS_DISTRO}-camera-info-manager \
    ros-${ROS_DISTRO}-image-transport \
    ros-${ROS_DISTRO}-rviz2 \
    ros-${ROS_DISTRO}-rqt \
    ros-${ROS_DISTRO}-rqt-common-plugins \
    ros-${ROS_DISTRO}-rqt-publisher \
    ros-${ROS_DISTRO}-rqt-tf-tree \
    ros-${ROS_DISTRO}-rqt-graph \
    ros-${ROS_DISTRO}-rqt-topic \
    ros-${ROS_DISTRO}-rqt-reconfigure \
    ros-${ROS_DISTRO}-plotjuggler-ros \
    ros-${ROS_DISTRO}-xacro \
    ros-${ROS_DISTRO}-joy \
    ros-${ROS_DISTRO}-ament-cmake-clang-format \
    ros-${ROS_DISTRO}-ament-cmake-black \
    ros-${ROS_DISTRO}-ament-cmake-clang-tidy \
    libignition-msgs8-dev \
    libignition-transport11-dev \
    libunwind-dev \
    libgoogle-glog-dev \
    libopencv-dev \
    libasio-dev \
    libusb-1.0-0-dev \
    usbutils \
    vim \
    nano \
  && rm -rf /var/lib/apt/lists/*

# ---------- rosdep 初始化 ----------
RUN rosdep init 2>/dev/null || true && rosdep update

# ---------- 用 package.xml 快照安装 ROS 包依赖 ----------
# 只复制快照（不含代码），让 apt/rosdep 这一层长期命中缓存。
COPY docker/rosdep_src/ /tmp/rosdep_src/

RUN if [[ -n "${APT_MIRROR}" ]]; then \
      export no_proxy="${no_proxy:+${no_proxy},}${APT_MIRROR}"; \
      export NO_PROXY="${NO_PROXY:+${NO_PROXY},}${APT_MIRROR}"; \
    fi \
  && apt-get update \
  && source /opt/ros/${ROS_DISTRO}/setup.bash \
  && rosdep install -r --from-paths /tmp/rosdep_src --ignore-src \
     --rosdistro ${ROS_DISTRO} -y \
     --skip-keys auto_aim_interfaces \
  && rm -rf /var/lib/apt/lists/* /tmp/rosdep_src

# ---------- 预编译 small_gicp（系统级库，不随业务代码变化） ----------
COPY src/small_gicp/ /tmp/small_gicp_src/

RUN cmake -S /tmp/small_gicp_src -B /tmp/small_gicp_build \
      -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_HELPER=ON \
      -DBUILD_TESTS=OFF \
      -DBUILD_EXAMPLES=OFF \
      -DBUILD_BENCHMARKS=OFF \
      -DBUILD_PYTHON_BINDINGS=OFF \
      -DCMAKE_BUILD_PARALLEL_LEVEL="$(nproc)" \
  && cmake --build /tmp/small_gicp_build \
  && cmake --install /tmp/small_gicp_build \
  && rm -rf /tmp/small_gicp_src /tmp/small_gicp_build

# ---------- NeuPAN Python venv ----------
# 只复制 requirements.txt，代码不进镜像。
# venv 放在 /ws/neupan_env，挂载 src 时不会覆盖它（src 在 /ws/src）。
COPY src/neupan_nav2_controller/requirements.txt /tmp/neupan_requirements.txt
COPY scripts/setup_neupan_env.sh /tmp/setup_neupan_env.sh

RUN chmod +x /tmp/setup_neupan_env.sh \
  && VENV_DIR=/ws/neupan_env \
     REQ_FILE=/tmp/neupan_requirements.txt \
     /tmp/setup_neupan_env.sh \
  && rm /tmp/neupan_requirements.txt /tmp/setup_neupan_env.sh

# ---------- Python 工具（全局，供 launch 脚本直接调用）----------
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
# xmacro 在清华源；mcap 系列只在 PyPI，通过宿主机代理（network:host 保证可达）安装
RUN pip3 install --no-cache-dir \
      -i ${PIP_INDEX_URL} --trusted-host ${PIP_TRUSTED_HOST} \
      xmacro \
 && HTTPS_PROXY=http://127.0.0.1:7897 HTTP_PROXY=http://127.0.0.1:7897 \
    pip3 install --no-cache-dir mcap mcap-ros2-support

# ---------- udev rules (Odin1 USB device) ----------
RUN mkdir -p /etc/udev/rules.d \
  && echo 'SUBSYSTEM=="usb", ATTR{idVendor}=="2207", ATTR{idProduct}=="0019", MODE="0666", GROUP="plugdev"' \
     > /etc/udev/rules.d/99-odin-usb.rules

# ---------- entrypoint ----------
COPY docker/ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
