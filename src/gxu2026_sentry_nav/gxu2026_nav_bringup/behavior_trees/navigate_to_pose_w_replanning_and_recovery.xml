<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3"
      main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!--
      改动说明（v4）：
      移除 Spin+BackUp 恢复动作，恢复逻辑由 RMUL 行为树层处理。
      Nav2 内部仅做规划+跟踪的重试，不做实体恢复动作。
      
      RMUL BT 层通过 IsNavigationStuck + FindEscapePoint 实现统一脱困：
      - 全局脱困：不受距目标点距离限制，搜索最开阔位置
      - 局部脱困：靠近目标时搜索后退方向逃脱点
    -->
    <RecoveryNode name="NavigateRecovery"
                  number_of_retries="6">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode name="ComputePathToPose"
                        number_of_retries="1">
            <ComputePathToPose goal="{goal}"
                               path="{path}"
                               planner_id="GridBased"/>
            <GoalUpdated/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode name="FollowPath"
                      number_of_retries="1">
          <FollowPath path="{path}"
                      controller_id="FollowPath"/>
          <GoalUpdated/>
        </RecoveryNode>
      </PipelineSequence>
      <!-- 恢复策略：仅检查目标是否更新，不执行 Spin/BackUp -->
      <GoalUpdated/>
    </RecoveryNode>
  </BehaviorTree>
</root>
