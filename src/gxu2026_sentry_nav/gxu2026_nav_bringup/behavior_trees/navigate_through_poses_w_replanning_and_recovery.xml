<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3"
      main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!--
      改动说明（v4）：
      移除 Spin+BackUp 恢复动作，恢复逻辑由 RMUL 行为树层处理。
      Nav2 内部仅做规划+跟踪的重试，不做实体恢复动作。
    -->
    <RecoveryNode name="NavigateRecovery"
                  number_of_retries="6">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode name="ComputePathThroughPoses"
                        number_of_retries="1">
            <ReactiveSequence>
              <RemovePassedGoals input_goals="{goals}"
                                 output_goals="{goals}"
                                 radius="0.8"
                                 robot_base_frame="gimbal_yaw_fake"/>
              <ComputePathThroughPoses goals="{goals}"
                                       path="{path}"
                                       planner_id="GridBased"/>
            </ReactiveSequence>
            <GoalUpdated/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode name="FollowPath"
                      number_of_retries="1">
          <FollowPath path="{path}"
                      controller_id="FollowPath"/>
          <GoalUpdated/>
        </RecoveryNode>
      </PipelineSequence>
      <!-- 恢复策略：仅检查目标是否更新，不执行 Spin/BackUp -->
      <GoalUpdated/>
    </RecoveryNode>
  </BehaviorTree>
</root>
