<?xml version='1.0' encoding='utf-8'?>
<sdf version='1.7'>
  <world name='default'>
    <!-- Physics -->
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics">
    </plugin>

    <!-- Forwards simulation state to the GUI -->
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>

    <!-- Processes user commands, like translate and create -->
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands">
    </plugin>

    <!-- Generates rendering sensor data -->
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu">
    </plugin>

    <light type='directional' name='direct_light'>
      <visualize>false</visualize>
      <cast_shadows>true</cast_shadows>
      <pose>14.6 7.9 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
    </light>

    <model name='rmuc_2026'>
      <include>
        <uri>model://rmuc_2026</uri>
      </include>
      <pose>14 9 0 0 0 0</pose>
      <static>true</static>
    </model>
  
    <model name='speed_bump1'>
      <include>
        <uri>model://speed_bump</uri>
      </include>
      <pose>-10.2860 -4.7945 0.5354 1.57 0 0</pose>
      <static>true</static>
    </model>

    <model name='speed_bump2'>
      <include>
        <uri>model://speed_bump</uri>
      </include>
      <pose>4.9294 8.1159 0.5354 1.57 0 0</pose>
      <static>true</static>
    </model>    

    <!-- ========== 边界墙 (防止机器人掉出场地) ========== -->
    <!-- 东墙 -->
    <model name='boundary_wall_east'>
      <static>true</static>
      <pose>15.1 0.6 1.0 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>1.0 17.0 2.0</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>1e8</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry><box><size>1.0 17.0 2.0</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.2 0.3</ambient>
            <diffuse>0.8 0.2 0.2 0.3</diffuse>
          </material>
          <transparency>0.7</transparency>
        </visual>
      </link>
    </model>

    <!-- 西墙 -->
    <model name='boundary_wall_west'>
      <static>true</static>
      <pose>-15.1 0.6 1.0 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>1.0 17.0 2.0</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>1e8</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry><box><size>1.0 17.0 2.0</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.2 0.3</ambient>
            <diffuse>0.8 0.2 0.2 0.3</diffuse>
          </material>
          <transparency>0.7</transparency>
        </visual>
      </link>
    </model>

    <!-- 北墙 -->
    <model name='boundary_wall_north'>
      <static>true</static>
      <pose>0.0 9.1 1.0 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>31.2 1.0 2.0</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>1e8</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry><box><size>31.2 1.0 2.0</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.2 0.3</ambient>
            <diffuse>0.8 0.2 0.2 0.3</diffuse>
          </material>
          <transparency>0.7</transparency>
        </visual>
      </link>
    </model>

    <!-- 南墙 -->
    <model name='boundary_wall_south'>
      <static>true</static>
      <pose>0.0 -7.9 1.0 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>31.2 1.0 2.0</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>1e8</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry><box><size>31.2 1.0 2.0</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.2 0.3</ambient>
            <diffuse>0.8 0.2 0.2 0.3</diffuse>
          </material>
          <transparency>0.7</transparency>
        </visual>
      </link>
    </model>
  </world>
</sdf>
