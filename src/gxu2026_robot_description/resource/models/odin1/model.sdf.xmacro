<?xml version="1.0"?>
<sdf version="1.7">
  <!--xmacro_define_block: odin1-->
  <xmacro_define_block name="odin1" params="prefix parent pose update_rate samples">
    <joint name="${prefix}odin1_joint" type="fixed">
      <pose relative_to="${parent}">${pose}</pose>
      <parent>${parent}</parent>
      <child>${prefix}odin1</child>
    </joint>
    <link name="${prefix}odin1">
      <pose relative_to="${prefix}odin1_joint">0.0 0.0 0.0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.02 0 0 0</pose>
        <xmacro_block name="inertia_cylinder" m="0.005" r="0.04" l="0.04" />
      </inertial>
      <visual name="visual">
        <pose>0.0 0.0 0.0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://odin1/meshes/odin1.dae</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0.0 0.0 0.0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://odin1/meshes/odin1.dae</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>

      <sensor name="${prefix}odin1_imu" type="imu">
        <ignition_frame_id>${prefix}odin1</ignition_frame_id>
        <always_on>1</always_on>
        <update_rate>200</update_rate>
        <visualize>true</visualize>
      </sensor>

      <sensor name="${prefix}odin1_lidar" type="gpu_lidar">
        <ignition_frame_id>${prefix}odin1</ignition_frame_id>
        <pose>0 0 0.03 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>${update_rate}</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>${samples}</samples>
              <resolution>1.0</resolution>
              <!-- Odin1 文档：约 120°H -->
              <min_angle>-1.0471975512</min_angle>
              <max_angle>1.0471975512</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <!-- Odin1 文档：约 90°V -->
              <min_angle>-0.7853981634</min_angle>
              <max_angle>0.7853981634</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>40.0</max>
          </range>
        </ray>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </sensor>
    </link>
  </xmacro_define_block>

  <!--Odin1-->
  <model name='simple_odin1'>
    <pose>0 0 0.2 0 0 0</pose>
    <link name="base_link">
      <inertial>
        <xmacro_block name="inertia_box" m="0.4" x="0.4" y="0.4" z="0.4" />
      </inertial>
      <visual name="visual">
        <xmacro_block name="geometry_box" x="0.4" y="0.4" z="0.4" />
      </visual>
      <collision name="collision">
        <xmacro_block name="geometry_box" x="0.4" y="0.4" z="0.4" />
      </collision>
    </link>
    <!--update_rate(10-15),samples(400)-->
    <xmacro_block name="odin1" prefix="simple_" parent="base_link" pose="0 0 0.2 0 0 0" update_rate="10" samples="1500"/>
  </model>
</sdf>
