# =============================================================================
# RMUC.msg — RMUC 2026 哨兵自主决策行为树统一消息接口
# =============================================================================
#
# 本消息为行为树与电控/嵌入式之间的统一数据接口。
# 遵循 RMUL.msg 的"单一消息多话题"模式：所有话题共用同一消息类型，
# 各订阅节点仅读取对应字段。
#
# ┌────────────────────────┬───────────┬──────────────────┐
# │  话题 (Topic)          │ 方向      │ BT 订阅/发布节点 │
# ├────────────────────────┼───────────┼──────────────────┤
# │  /game_status          │ 电控 → BT │ SubGameStatus    │
# │  /robot_status         │ 电控 → BT │ SubRobotStatus   │
# │  /rfid_status          │ 电控 → BT │ SubRFIDStatus    │
# │  /robot_position       │ 定位 → BT │ SubRobotPosition │
# │  /radar/enemy_tracks   │ 雷达 → BT │ SubRadarTracks   │
# │  /sentry_cmd           │ BT → 电控 │ SentryCmdMux     │
# │  /robot_control        │ BT → 电控 │ RobotControl     │
# └────────────────────────┴───────────┴──────────────────┘
#
# 协议中的 bit 字段均已展开为独立字段，电控侧负责按裁判系统协议打包/解包。
# 编译时请将本文件复制到 rm_decision_interfaces/msg/ 并在 CMakeLists.txt 中注册。
# =============================================================================

std_msgs/Header header

# ═══════════════════════════════════════════════════════════════════════════════
#  [INPUT] 电控/传感器 → 行为树（电控侧发布，行为树侧订阅）
# ═══════════════════════════════════════════════════════════════════════════════


# ── 1. 比赛状态 (裁判系统 0x0001) ───────────────────────────────────────────
# 话题: /game_status
# 订阅节点: SubGameStatus → 写入黑板 {game_status}
# 下游引用:
#   - IsGameTime             : 读 game_progress / stage_remain_time 判断是否处于比赛阶段
#   - ParseSentryBlackboard  : 读完整 game_status → 派生 {game.remain_s} / {game.elapsed_s}
# ─────────────────────────────────────────────────────────────────────────────
uint8  game_progress         # 比赛阶段
                             #   0=未开始  1=准备阶段  2=自检阶段
                             #   3=5秒倒计时  4=比赛进行中  5=结算中
uint16 stage_remain_time     # 当前阶段剩余时间 (秒)


# ── 2. 机器人血量与射击热量 (0x0201 / 0x0202) ──────────────────────────────
# 话题: /robot_status
# 订阅节点: SubRobotStatus → 写入黑板 {robot_status}
# 下游引用:
#   - ParseSentryBlackboard  : 派生 {hp.cur} / {hp.max} / {heat.cur}
#   - IsDead                 : 判断死亡 (current_hp == 0)
#   - IsWeakness             : 判断虚弱状态 (复活后发射锁定)
#   - IsHPBelow              : 比较 current_hp 与 hp_threshold
#   - IsCriticalState        : 血量或热量达到危急阈值
#   - IsCombatAllowed        : 综合判断是否允许交战 (hp/heat/ammo/weak)
#   - DecidePosture          : hp_cur / hp_max / heat_cur 影响姿态选择
#   - DecideRespawnCmd       : 读复活读条状态与战场态势
# ─────────────────────────────────────────────────────────────────────────────
uint16 current_hp            # 当前血量
uint16 max_hp                # 血量上限
uint16 shooter_heat          # 当前枪口热量
uint16 heat_limit            # 热量上限 (供 FireBurst 自适应控热参考)
uint16 cooling_rate          # 每秒冷却值 (供 FireBurst 自适应控热参考)


# ── 3. 弹丸与允许发弹量 ────────────────────────────────────────────────────
# 话题: /robot_status (与血量合并发布)
# 下游引用:
#   - ParseSentryBlackboard  : 派生 {ammo.allow} / {ammo.left}
#   - IsAmmoBelow            : 比较 ammo_allow < cfg.ammo_low → 触发补弹
#   - DecideEconomyCmd       : 计算远程兑换策略 / 允许发弹量目标
#   - IsFireWindowOk         : 判断当前是否有弹可发
#   - IsCombatAllowed        : ammo_allow 作为交战前提之一
#   - HoldForSupplyAmmoTick  : 等待补给区每分钟 +100 免费发弹量
# ─────────────────────────────────────────────────────────────────────────────
uint16 ammo_allow            # 剩余允许发弹量 (裁判系统 allowance)
uint16 ammo_left             # 物理剩余弹丸数 (若下位机可提供；否则填 0xFFFF)


# ── 4. 机器人状态标志 ──────────────────────────────────────────────────────
# 话题: /robot_status (与血量合并发布)
# 下游引用:
#   - ParseSentryBlackboard  : 派生 {state.is_dead}/{state.is_weak}/
#                               {state.disengaged}/{state.disengage_cd_s}
#   - IsDead                 : 判断战亡
#   - IsWeakness             : 判断虚弱 (复活后发射锁定，需触卡解除)
#   - IsCombatAllowed        : is_weak 为交战否决条件
#   - IsFireWindowOk         : is_weak 时禁止开火
#   - DecideEconomyCmd       : is_disengaged 为远程兑换前提
#   - DecidePosture          : is_disengaged 影响姿态决策
#   - HoldAndHeal            : is_disengaged 影响回血速率
#                               (脱战 + 补给区 + 4 分钟后 = 25%/s 高速回血)
# ─────────────────────────────────────────────────────────────────────────────
bool    is_dead              # 是否战亡 (current_hp == 0 且未复活)
bool    is_weak              # 是否虚弱 (复活后发射锁定，需触碰增益点解除)
bool    is_disengaged        # 是否脱战 (连续 6s 未发射弹丸且未被扣血)
float32 disengage_cd_s       # 脱战倒计时 (秒；0.0=已脱战；>0=距脱战还剩 N 秒)


# ── 5. 经济与远程能力 ──────────────────────────────────────────────────────
# 话题: /robot_status (与血量合并发布)
# 下游引用:
#   - ParseSentryBlackboard  : 派生 {economy.can_remote_heal} /
#                               {economy.can_remote_ammo} / {economy.coins}
#   - DecideEconomyCmd       : 判断是否触发远程补血/补弹，参考金币与脱战状态
#   - DecideRespawnCmd       : team_coins 决定是否兑换立即复活
# ─────────────────────────────────────────────────────────────────────────────
bool   can_remote_heal       # 是否可触发远程补血 (脱战 + 冷却完成 + 金币 ≥ 消耗)
bool   can_remote_ammo       # 是否可触发远程补弹 (同上)
uint16 team_coins            # 队伍当前金币余额


# ── 6. 复活状态 ────────────────────────────────────────────────────────────
# 话题: /robot_status (与血量合并发布)
# 下游引用:
#   - DecideRespawnCmd       : 判断是否确认复活 / 兑换立即复活
# ─────────────────────────────────────────────────────────────────────────────
bool   can_respawn           # 复活读条是否完成 (true=可确认复活)
uint8  respawn_countdown_s   # 复活读条倒计时 (秒；0=可立即确认)


# ── 7. 己方基地与前哨站 (0x0003 / 0x0101 / 0x0105) ────────────────────────
# 话题: /robot_status (建议电控与机器人状态合并发布)
# 下游引用:
#   - ParseSentryBlackboard  : 派生 {base.hp.cur} / {base.hp.max} / {outpost.alive}
#   - IsBaseThreatened       : base_hp 趋势 + 敌方接近 → 判断基地威胁
#   - DecideRespawnCmd       : base_hp 评估守家紧迫度 → 是否兑换立即复活
#   - SelectObjective        : base_hp deficit 决定是否优先占领己方堡垒
# ─────────────────────────────────────────────────────────────────────────────
uint16 base_hp_cur           # 己方基地当前血量
uint16 base_hp_max           # 己方基地血量上限
bool   outpost_alive         # 己方前哨站是否存活


# ── 8. RFID / 场地交互模块状态 (0x0209) ────────────────────────────────────
# 话题: /rfid_status
# 订阅节点: SubRFIDStatus → 写入黑板 {rfid.status}
# 下游引用:
#   - IsZoneCardDetected     : 检测指定区域是否已触发
#                               (zone="SUPPLY"/"BASE_BUFF"/"OUTPOST_BUFF"/...)
#   - IsAnyDispelCardDetected: 检测任意可解除虚弱的区域
#                               (补给区 / 基地增益点 / 前哨站增益点)
# 备注: 模块卡存在 ~2s 延迟与死区，实现侧应做去抖滤波
# ─────────────────────────────────────────────────────────────────────────────
bool   rfid_supply           # 补给区增益点 RFID 触发
bool   rfid_base_buff        # 基地增益点 RFID 触发
bool   rfid_outpost_buff     # 前哨站增益点 RFID 触发
bool   rfid_fortress_enemy   # 敌方堡垒 RFID 触发
bool   rfid_central_highland # 中央高地 RFID 触发
bool   rfid_ladder_highland  # 梯形高地 RFID 触发


# ── 9. 机器人位姿 (0x0203 / 定位系统) ─────────────────────────────────────
# 话题: /robot_position
# 订阅节点: SubRobotPosition → 写入黑板 {pose.x} / {pose.y} / {pose.yaw}
# 下游引用:
#   - SelectBestTarget            : 计算自身与敌方目标距离
#   - SelectObjective             : 计算候选目标点距离，选择最优目标
#   - SelectNearestDispelCard     : 选择最近的可触卡区域 (虚弱解除)
#   - SelectNearestResupplyStation: 选择最近的补给/兑换点
#   - SelectSafeRetreatGoal       : 选择安全撤退目标
#   - IsAtGoal                    : 判断是否到达导航目标点
#   - WaypointPatrol              : 巡逻路径规划
#   - MoveAround                  : 到达目标后微动触卡
# ─────────────────────────────────────────────────────────────────────────────
float32 pose_x               # 位置 x (meter, map 坐标系)
float32 pose_y               # 位置 y (meter, map 坐标系)
float32 pose_yaw             # 航向角 (radian, map 坐标系)


# ── 9b. 导航到达判定 ──────────────────────────────────────────────────────
# 话题: /robot_position (建议与位姿合并发布)
# 下游引用:
#   - IsAtNavGoal            : RespawnRecovery 子树中判断是否到达导航目标
# ─────────────────────────────────────────────────────────────────────────────
bool   is_at_nav_goal        # 是否到达导航目标点 (true=已到达)


# ── 10. 雷达敌方目标跟踪 ──────────────────────────────────────────────────
# 话题: /radar/enemy_tracks
# 订阅节点: SubRadarTracks → 写入黑板 {radar.tracks}
# 下游引用:
#   - ParseSentryBlackboard  : 预处理全部目标 → 派生 {combat.has_target} /
#                               {combat.best_target} / {threat.base} / {threat.fortress}
#   - SelectBestTarget       : 从目标列表选出最优交战目标
#                               (综合距离/对基地威胁/目标类型)
# 备注: RMUC 最多 7 个敌方机器人 (英雄/工程/步兵×3/哨兵/空中)
#        各数组长度须一致且等于 enemy_count
# ─────────────────────────────────────────────────────────────────────────────
uint8     enemy_count        # 当前有效跟踪目标数量 (0~7)
uint8[]   enemy_robot_id     # 敌方机器人 ID (1~7=红方 / 101~107=蓝方)
float32[] enemy_x            # 敌方位置 x (meter, map 坐标系)
float32[] enemy_y            # 敌方位置 y (meter, map 坐标系)
float32[] enemy_confidence   # 跟踪置信度 [0.0, 1.0]（雷达/视觉融合置信度）


# ═══════════════════════════════════════════════════════════════════════════════
#  [OUTPUT] 行为树 → 电控/嵌入式（行为树侧发布，电控侧订阅并执行）
# ═══════════════════════════════════════════════════════════════════════════════


# ── 11. 哨兵自主决策指令 (裁判系统 0x0120，bit 已展开) ─────────────────────
# 话题: /sentry_cmd
# 发布节点: SentryCmdMux（CommandHub 子树，RateController 2Hz 节拍发布）
# 上游来源:
#   - DecidePosture       → cmd_posture
#   - DecideRespawnCmd    → cmd_confirm_respawn / cmd_confirm_instant_respawn
#   - DecideEconomyCmd    → cmd_allow_ammo_target / cmd_trigger_remote_ammo /
#                            cmd_trigger_remote_hp / cmd_enable_big_energy
#
# ╔═══════════╤═══════════════════════════════════════════════════════════════╗
# ║ 0x0120 bit║  对应 msg 字段                                              ║
# ╠═══════════╪═══════════════════════════════════════════════════════════════╣
# ║ bit 0     │  cmd_confirm_respawn           (1=确认复活)                  ║
# ║ bit 1     │  cmd_confirm_instant_respawn   (1=确认兑换立即复活)          ║
# ║ bit 2-12  │  cmd_allow_ammo_target         (允许发弹量目标，单调递增)    ║
# ║ bit 13-16 │  远程补弹计数 (电控维护，每次 cmd_trigger_remote_ammo ↑ +1) ║
# ║ bit 17-20 │  远程补血计数 (电控维护，每次 cmd_trigger_remote_hp   ↑ +1) ║
# ║ bit 21-22 │  cmd_posture                   (1=进攻 2=防御 3=移动)       ║
# ║ bit 23    │  cmd_enable_big_energy         (1=确认激活大能量机关)        ║
# ╚═══════════╧═══════════════════════════════════════════════════════════════╝
#
# 说明:
#   - bit 13-16 / bit 17-20 为单调递增计数，由电控侧维护。
#     BT 侧仅通过 trigger 字段的上升沿 (false→true) 通知电控累加一次。
#   - cmd_allow_ammo_target 为"累计目标值"，协议要求单调不回退，
#     电控侧写入 bit 2-12 时应保证不低于上一次发送值。
# ─────────────────────────────────────────────────────────────────────────────
uint8  cmd_posture                  # 姿态 (1=进攻 2=防御 3=移动)
bool   cmd_confirm_respawn          # 确认复活 (true=确认)
bool   cmd_confirm_instant_respawn  # 确认兑换立即复活 (true=确认，消耗金币)
uint16 cmd_allow_ammo_target        # 允许发弹量目标值 (单调递增)
bool   cmd_trigger_remote_ammo      # 触发远程兑换弹丸 (上升沿有效: false→true +1)
bool   cmd_trigger_remote_hp        # 触发远程兑换血量 (上升沿有效: false→true +1)
bool   cmd_enable_big_energy        # 大能量机关确认 (true=确认激活)


# ── 12. 机器人控制命令 ────────────────────────────────────────────────────
# 话题: /robot_control
# 发布节点: RobotControl（几乎所有战术子树均使用，参数随场景不同）
# 各子树使用情况:
#   ┌──────────────────────┬──────┬──────┬──────┐
#   │ 子树                 │ stop │ spin │ fire │
#   ├──────────────────────┼──────┼──────┼──────┤
#   │ DeathAndRespawn      │  T   │  F   │  F   │  死亡时禁止一切
#   │ WeaknessRecovery     │  F   │  F   │  F   │  虚弱，允许扫描但禁射
#   │ CriticalSurvival     │  F   │  F   │  F   │  危急撤退，不开火
#   │ BaseDefense          │  F   │  F   │  T   │  守家，允许开火
#   │ EngageCombat         │  T   │  T   │  T   │  交战: 锁定+陀螺+开火
#   │ CombatLoop (无窗口)  │  -   │  -   │  F   │  开火窗口不满足时暂停
#   │ HealPlan             │  F   │  F   │  F   │  回血，禁火保脱战
#   │ AmmoPlan             │  F   │  F   │  F   │  补弹，禁火保脱战
#   │ ObjectivePlanner     │  F   │  F   │  F   │  占点，禁火
#   │ PatrolAndScan        │  F   │  F   │  F   │  巡逻扫描
#   │ 主树(非比赛阶段)     │  T   │  F   │  F   │  回家待命
#   └──────────────────────┴──────┴──────┴──────┘
#   (T=true, F=false, stop=stop_gimbal_scan, spin=chassis_spin, fire=fire_enable)
# ─────────────────────────────────────────────────────────────────────────────
bool   stop_gimbal_scan      # 停止云台扫描 (false=持续扫描, true=停止扫描)
bool   chassis_spin          # 底盘小陀螺旋转 (false=不旋转, true=旋转)
bool   fire_enable           # 允许发射 (false=发射锁定, true=允许开火)


# ── 13. 导航控制命令 ──────────────────────────────────────────────────────
# 话题: /nav_control_cmd
# 发布节点: NavControlCmd（RespawnRecovery 子树）
# 下游引用:
#   - RespawnRecovery 子树中控制导航模式切换 (开始/终止/原地不动)
# ─────────────────────────────────────────────────────────────────────────────
int32  cmd_type              # 导航控制指令: 0=无操作 1=开始导航 2=终止导航 3=原地不动
bool   emergency_stop        # 紧急停止 (true=立刻停车，优先级最高)
