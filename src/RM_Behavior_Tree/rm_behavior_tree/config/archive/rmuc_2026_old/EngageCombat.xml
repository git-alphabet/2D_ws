<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

    <BehaviorTree ID="EngageCombat">
        <ReactiveSequence>
            <!--
                检查雷达是否有有效目标（has_target 为 true 且 best_target 非空），否则整棵树不执行
                - has_target   : ParseSentryBlackboard 判断 RMUCEnemyTracks.enemy_count > 0 后写入黑板
                - best_target  : ParseSentryBlackboard 粗筛——遍历所有敌方，选距自身欧氏距离最近者，
                                 打包为 "id:x:y" 字符串写入黑板；战斗循环内由 SelectBestTarget 精选
                                 （优先选距己方基地 <5m 的威胁目标，否则退回选距自身最近）
            -->
            <HasValidTarget has_target="{combat.has_target}"
                            best_target="{combat.best_target}"/>
            <!-- 战斗许可检查：处于虚弱状态、弹药为零、热量过高或血量过低时禁止战斗 -->
            <IsCombatAllowed is_weak="{state.is_weak}"
                             ammo_allow="{ammo.allow}"
                             heat_cur="{heat.cur}"
                             heat_high="{cfg.heat_high}"
                             hp_cur="{hp.cur}"
                             hp_low="{cfg.hp_low}"/>
            <!-- 开启云台跟踪、底盘旋转和开火，进入主动进攻姿态 -->
            <RmucRobotControl stop_gimbal_scan="True"
                              chassis_spin="True"
                              fire_enable="True"/>
            <!-- 进入战斗循环：选择最优目标、瞄准、判断射击窗口、连发射击，持续运行 -->
            <SubTree ID="CombatLoop" _autoremap="true"/>
        </ReactiveSequence>
    </BehaviorTree>

</root>
