<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="MainBehaviorTree">
    
    <include path="HighHP_combat_logic.xml"/>
    <include path="perception_and_blackboard.xml"/>
    <include path="IsDeadAndDispelDebuff.xml"/>

    <BehaviorTree ID="MainBehaviorTree">
        <ReactiveSequence>
            <!-- 用Sequence包裹所有节点，确保BehaviorTree只有1个子节点 -->
            <!-- 订阅数据并写入黑板 -->
            <SubTree ID="PerceptionAndBlackboard" _autoremap="true"/>
            
            <ForceSuccess>
                <CalibrateCenterAnchor map_frame="map"
                                       base_frame="base_footprint"
                                       manual_only="true"
                                       point_topic="/calib/spawn_point"
                                       force_recalibrate="false"
                                       marker_topic="/calibrated_points"
                                       marker_namespace="spawn_point"
                                       marker_color="black"
                                       marker_id="2001"
                                       center_x="{calib.spawn_x}"
                                       center_y="{calib.spawn_y}"
                                       center_yaw="{calib.spawn_yaw}"
                                       center_valid="{calib.spawn_valid}"
                                       center_pose="{calib.spawn_pose}"/>
            </ForceSuccess>
            
            <ForceSuccess>
                <CalibrateCenterAnchor map_frame="map"
                                       base_frame="base_footprint"
                                       manual_only="true"
                                       point_topic="/calib/control_point"
                                       force_recalibrate="false"
                                       marker_topic="/calibrated_points"
                                       marker_namespace="control_zone_point"
                                       marker_color="red"
                                       marker_id="2002"
                                       center_x="{calib.anchor_x}"
                                       center_y="{calib.anchor_y}"
                                       center_yaw="{calib.anchor_yaw}"
                                       center_valid="{calib.anchor_valid}"
                                       center_pose="{calib.anchor_pose}"/>
            </ForceSuccess>
            
            <WhileDoElse>
                                <IsGameTime name="IsGameStart"
                        message="{game_status}"
                        game_progress="4"
                        lower_remain_time="0"
                        higher_remain_time="300"/>
                <ReactiveSequence>
                    <!--
                        全局脱困检测：不依赖距离目标点远近
                        场景：开场拥挤、雷达被队友遮挡导致 costmap 堵死
                        策略：8秒未移动且未处于战斗状态 → 清空 local costmap → 用新鲜观测重建
                        排除1：检测到敌人时不判定卡住（战斗中原地停车是正常行为）
                        排除2：已到达控制区时不判定卡住（霸占控制区不动是正常行为）
                    -->
                    <ForceSuccess>
                        <ReactiveSequence>
                            <Inverter>
                                <IsDetectEnemy message="{robot_status}"/>
                            </Inverter>
                            <Inverter>
                                <IsWithinScope pose_x="{pose.x}" pose_y="{pose.y}"
                                               goal_x="{cfg.control_zone_goal_x}"
                                               goal_y="{cfg.control_zone_goal_y}"
                                               arrive_radius="{cfg.arrive_radius}"/>
                            </Inverter>
                            <IsRobotStuck pose_x="{pose.x}" pose_y="{pose.y}"
                                          stuck_timeout_ms="8000"
                                          movement_threshold="0.15"
                                          reset_distance="0.5"/>
                            <ClearCostmap service_name="local_costmap/clear_entirely" timeout_ms="1000"/>
                            <ClearCostmap service_name="global_costmap/clear_entirely" timeout_ms="1000"/>
                        </ReactiveSequence>
                    </ForceSuccess>

                <ReactiveFallback>
                    <!--判断战亡/低血量，若战亡或需要恢复，执行恢复操作 -->
                    <SubTree ID="IsDeadAndDispelDebuff" _autoremap="true"/>
                    <ExecuteNav2Waypoints action_name="navigate_through_poses"/>
                    <!-- 处于存活状态则进入战斗/占点逻辑 -->
                    <Fallback>
                                                <!--
                                                    二段制决策：
                                                        1. 高血量(HP >= 阈值): 进入高血战斗逻辑
                                                        2. 低血量(HP < 阈值): 由恢复子树接管，回补给区回血
                                                -->

                                                <!-- 高血量战斗逻辑 (HP >= cfg.hp_high_threshold) -->
                        <SubTree ID="HighHPCombatLogic" _autoremap="true"/>

                        <!-- 非战斗时刻占点逻辑 -->
                        <ReactiveFallback>

                            <!-- 3) 抢控制区：对方每秒-1胜利点；离开后延迟2s失效 -->
                            <ReactiveSequence>
                                <ReactiveFallback name="NavUntilArrived_ControlZone">
                                    <IsWithinScope pose_x="{pose.x}" pose_y="{pose.y}" goal_x="{cfg.control_zone_goal_x}" goal_y="{cfg.control_zone_goal_y}" arrive_radius="{cfg.arrive_radius}"/>
                                    <ReactiveSequence>
                                        <RateController hz="1">
                                            <Fallback>
                                                <!-- 1) 未卡住：前往原始控制区目标点 -->
                                                <Sequence>
                                                    <Inverter>
                                                        <IsNavigationStuck pose_x="{pose.x}" pose_y="{pose.y}"
                                                                           goal_x="{cfg.control_zone_goal_x}"
                                                                           goal_y="{cfg.control_zone_goal_y}"
                                                                           stuck_check_radius="{cfg.stuck_check_radius}"
                                                                           stuck_timeout_ms="5000"
                                                                           movement_threshold="0.15"
                                                                           reset_distance="0.5"/>
                                                    </Inverter>
                                                    <SendGoal name="GoControlZone_Normal"
                                                            goal_x="{cfg.control_zone_goal_x}"
                                                            goal_y="{cfg.control_zone_goal_y}"
                                                            frame_id="map"
                                                            action_name="navigate_to_pose" min_interval_ms="1000"/>
                                                </Sequence>
                                                <!-- 2) 卡住：清除代价地图 + 偏移目标点 -->
                                                <Sequence>
                                                    <ForceSuccess>
                                                        <ClearCostmap service_name="local_costmap/clear_entirely" timeout_ms="1000"/>
                                                    </ForceSuccess>
                                                    <ForceSuccess>
                                                        <ClearCostmap service_name="global_costmap/clear_entirely" timeout_ms="1000"/>
                                                    </ForceSuccess>
                                                    <Fallback>
                                                        <!-- 2a) 校准偏移 -->
                                                        <Sequence>
                                                            <SetGoalFromCenterOffset center_x="{calib.anchor_x}"
                                                                                     center_y="{calib.anchor_y}"
                                                                                     center_yaw="{calib.anchor_yaw}"
                                                                                     offset_x="{cfg.control_zone_offset_x}"
                                                                                     offset_y="{cfg.control_zone_offset_y}"
                                                                                     goal_x="{nav.goal_x}"
                                                                                     goal_y="{nav.goal_y}"
                                                                                     goal_pose="{nav.goal_pose}"/>
                                                            <SnapGoalToFreeSpace goal_x="{nav.goal_x}" goal_y="{nav.goal_y}"
                                                                                 goal_pose="{nav.goal_pose}"
                                                                                 max_search_radius="1.0" search_step="0.1"/>
                                                            <SendGoal name="GoControlZone_Offset"
                                                                    goal_pose="{nav.goal_pose}"
                                                                    frame_id="map"
                                                                    action_name="navigate_to_pose" min_interval_ms="1000"/>
                                                        </Sequence>
                                                        <!-- 2b) 无校准数据：基于原始配置点偏移 -->
                                                        <Sequence>
                                                            <SetGoalFromCenterOffset center_x="{cfg.control_zone_goal_x}"
                                                                                     center_y="{cfg.control_zone_goal_y}"
                                                                                     center_yaw="0.0"
                                                                                     offset_x="{cfg.control_zone_offset_x}"
                                                                                     offset_y="{cfg.control_zone_offset_y}"
                                                                                     goal_x="{nav.goal_x}"
                                                                                     goal_y="{nav.goal_y}"
                                                                                     goal_pose="{nav.goal_pose}"/>
                                                            <SnapGoalToFreeSpace goal_x="{nav.goal_x}" goal_y="{nav.goal_y}"
                                                                                 goal_pose="{nav.goal_pose}"
                                                                                 max_search_radius="1.0" search_step="0.1"/>
                                                            <SendGoal name="GoControlZone_Fallback"
                                                                    goal_pose="{nav.goal_pose}"
                                                                    frame_id="map"
                                                                    action_name="navigate_to_pose" min_interval_ms="1000"/>
                                                        </Sequence>
                                                    </Fallback>
                                                </Sequence>
                                            </Fallback>
                                        </RateController>
                                        <KeepRunning/>
                                    </ReactiveSequence>
                                </ReactiveFallback>

                                <!-- 无 RFID 版本：到达控制区后保持运行，不再发布随机目标点 -->
                                <KeepRunning/>
                            </ReactiveSequence>

                        </ReactiveFallback>

                    </Fallback>
                </ReactiveFallback>
                </ReactiveSequence>
                <!-- 非比赛阶段停止云台和旋转，原地待命 -->
                <Sequence>
                    <RobotControl stop_gimbal_scan="True" chassis_spin="False"/>
                    <!-- 发送一个停止领航的空命令或者直接不发目标，就干等着 -->
                    <KeepRunning/>
                </Sequence>
            </WhileDoElse>
        </ReactiveSequence>
    </BehaviorTree>
    
    <!-- Description of Node Models (used by Groot) -->
    <TreeNodesModel>
        <Condition ID="IsRobotStuck" editable="true">
            <input_port name="pose_x" default="{pose.x}"/>
            <input_port name="pose_y" default="{pose.y}"/>
            <input_port name="stuck_timeout_ms" default="8000"/>
            <input_port name="movement_threshold" default="0.15"/>
            <input_port name="reset_distance" default="0.5"/>
        </Condition>
        <Action ID="ClearCostmap" editable="true">
            <input_port name="service_name" default="local_costmap/clear_entirely"/>
            <input_port name="timeout_ms" default="1000"/>
        </Action>
        <Action ID="ExecuteNav2Waypoints" editable="true">
            <input_port name="action_name" default="follow_waypoints"/>
        </Action>
        <Action ID="GetCurrentLocation" editable="true">
            <output_port name="current_location" default="{current_location}"/>
        </Action>
        <Action ID="IsDetectEnemy" editable="true">
            <input_port name="message" default="{armors}"/>
        </Action>
        <Action ID="MoveAround" editable="true">
            <input_port name="expected_nearby_goal_count" default="5"/>
            <input_port name="expected_dis" default="0.3"/>
            <input_port name="message" default="{current_location}"/>
        </Action>
        <Action ID="SendGoal" editable="true">
            <input_port name="goal_pose" default="{goal_pose}"/>
            <input_port name="goal_x" default="0.0"/>
            <input_port name="goal_y" default="0.0"/>
            <input_port name="frame_id" default="map"/>
            <!-- 补充action_name输入端口（解决GoSupplyToHeal端口不匹配报错） -->
            <input_port name="action_name" default="navigate_to_pose"/>
        </Action>
        <Action ID="IsControlZoneDetected" editable="true">
            <input_port name="rfid_status" default="{rfid.status}"/>
        </Action>
        <Action ID="SubArmors" editable="true">
            <input_port name="topic_name" default="detector/armors"/>
            <output_port name="armors" default="{armors}"/>
        </Action>
        <Action ID="SubGameStatus" editable="true">
            <input_port name="topic_name" default="game_status"/>
            <output_port name="game_status" default="{game_status}"/>
            <output_port name="now_ms" default="{time.now_ms}"/>
        </Action>
        <Action ID="SubRobotStatus" editable="true">
            <input_port name="topic_name" default="robot_status"/>
            <output_port name="robot_status" default="{robot_status}"/>
        </Action>
        <Action ID="SubRFIDStatus" editable="true">
            <input_port  name="topic_name" default="rfid_status"/>
            <output_port name="rfid_status" default="{rfid.status}"/>
        </Action>
        <Action ID="InitBlackboardConfig" editable="true">
            <output_port name="heal_wait_ms" default="{cfg.heal_wait_ms}"/>
            <output_port name="heal_min_hp" default="{cfg.heal_min_hp}"/>
            <output_port name="hp_high_threshold" default="{cfg.hp_high_threshold}"/>
            <output_port name="hp_medium_threshold" default="{cfg.hp_medium_threshold}"/>
            <output_port name="search_timeout_ms" default="{cfg.search_timeout_ms}"/>
            <output_port name="recovery_timeout_ms" default="{cfg.recovery_timeout_ms}"/>
            <output_port name="supply_goal_x" default="{cfg.supply_goal_x}"/>
            <output_port name="supply_goal_y" default="{cfg.supply_goal_y}"/>
            <output_port name="control_zone_goal_x" default="{cfg.control_zone_goal_x}"/>
            <output_port name="control_zone_goal_y" default="{cfg.control_zone_goal_y}"/>
            <output_port name="control_zone_offset_x" default="{cfg.control_zone_offset_x}"/>
            <output_port name="control_zone_offset_y" default="{cfg.control_zone_offset_y}"/>
            <output_port name="arrive_radius" default="{cfg.arrive_radius}"/>
            <output_port name="stuck_check_radius" default="{cfg.stuck_check_radius}"/>
        </Action>
        <Action ID="SubRobotPosition" editable="true">
            <input_port name="topic_name" default="robot_position"/>
            <output_port name="pose_x" default="{pose_x}"/>
            <output_port name="pose_y" default="{pose_y}"/>
        </Action>
        <Action ID="KeepRunning" editable="true"/>
        <Action ID="CancelNavGoal" editable="true">
            <input_port name="action_name" default="navigate_to_pose"/>
        </Action>
        <Action ID="DetectRespawnAndSetRecovery" editable="true">
            <inout_port name="was_dead" default="{state.was_dead}"/>
            <input_port name="hp_cur" default="{hp.cur}"/>
            <input_port name="now_ms" default="{time.now_ms}"/>
            <inout_port name="need_recovery" default="{state.need_recovery}"/>
            <inout_port name="recovery_start_ms" default="{state.recovery_start_ms}"/>
            <inout_port name="search_start_ms" default="{state.search_start_ms}"/>
            <inout_port name="heal_start_ms" default="{state.heal_start_ms}"/>
        </Action>
        <Action ID="ClearRecoveryFlag" editable="true">
            <inout_port name="need_recovery" default="{state.need_recovery}"/>
            <inout_port name="heal_start_ms" default="{state.heal_start_ms}"/>
            <inout_port name="search_start_ms" default="{state.search_start_ms}"/>
            <inout_port name="recovery_start_ms" default="{state.recovery_start_ms}"/>
        </Action>
        <Action ID="SetNavGoalFromConfig" editable="true">
            <input_port  name="cfg_x" default="{cfg.supply_goal_x}"/>
            <input_port  name="cfg_y" default="{cfg.supply_goal_y}"/>
            <output_port name="goal_x" default="{nav.goal_x}"/>
            <output_port name="goal_y" default="{nav.goal_y}"/>
        </Action>
        <Action ID="InitSearchTimerIfNeeded" editable="true">
            <inout_port name="search_start_ms" default="{state.search_start_ms}"/>
        </Action>
        <Action ID="MicroSearchSupplyCard" editable="true">
            <inout_port name="search_start_ms" default="{state.search_start_ms}"/>
            <input_port name="timeout_ms" default="{cfg.search_timeout_ms}"/>
            <input_port name="rfid_status" default="{rfid.status}"/>
            <input_port name="rfid_supply_arrived" default="{rfid.supply_arrived}"/>
        </Action>
        <Action ID="WaitAndHeal" editable="true">
            <input_port name="now_ms" default="{time.now_ms}"/>
            <inout_port name="heal_start_ms" default="{state.heal_start_ms}"/>
            <input_port name="heal_wait_ms" default="{cfg.heal_wait_ms}"/>
            <input_port name="hp_cur" default="{hp.cur}"/>
            <input_port name="hp_max" default="{hp.max}"/>
            <input_port name="heal_min_hp" default="{cfg.heal_min_hp}"/>
        </Action>
        <Action ID="RobotControl" editable="true">
            <input_port name="stop_gimbal_scan" default="False"/>
            <input_port name="chassis_spin" default="False"/>
        </Action>
        <Action ID="NavControlCmd" editable="true">
            <input_port name="cmd_type" default="0"/>
            <input_port name="emergency_stop" default="False"/>
        </Action>
        <Condition ID="IsDetectEnemy" editable="true">
            <input_port name="message" default="{robot_status}"/>
        </Condition>
        <Condition ID="IsFriendOK" editable="true">
            <input_port name="message" default="{robot_status}"/>
        </Condition>
        <Condition ID="IsGameTime" editable="true">
            <input_port name="message" default="{game_status}"/>
            <input_port name="game_progress" default="4"/>
            <input_port name="lower_remain_time" default="0"/>
            <input_port name="higher_remain_time" default="300"/>
        </Condition>
        <Condition ID="IsStatusOK" editable="true">
            <input_port name="message" default="{robot_status}"/>
            <input_port name="hp_threshold" default="0"/>
            <input_port name="heat_threshold" default="9999"/>
        </Condition>
        <Condition ID="IsHPAbove" editable="true">
            <input_port name="message" default="{robot_status}"/>
            <input_port name="hp_threshold" default="200"/>
        </Condition>
        <Condition ID="IsHPBelow" editable="true">
            <input_port name="message" default="{robot_status}"/>
            <input_port name="hp_threshold" default="100"/>
        </Condition>
        <Condition ID="IsDead" editable="true">
            <input_port name="message" default="{robot_status}"/>
        </Condition>
        <Condition ID="IsRecoveryNeeded" editable="true">
            <input_port name="need_recovery" default="{state.need_recovery}"/>
        </Condition>
        <Condition ID="IsSupplyCardDetected" editable="true">
            <input_port name="rfid_status" default="{rfid.status}"/>
        </Condition>
        <Condition ID="IsWithinScope" editable="true">
            <input_port name="pose_x" default="{pose.x}"/>
            <input_port name="pose_y" default="{pose.y}"/>
            <input_port name="goal_x" default="{cfg.supply_goal_x}"/>
            <input_port name="goal_y" default="{cfg.supply_goal_y}"/>
            <input_port name="arrive_radius" default="{cfg.arrive_radius}"/>
        </Condition>
        <Condition ID="NotArrived" editable="true">
            <input_port name="rfid_status" default="{rfid.status}"/>
        </Condition>
        <Condition ID="IsAtNavGoal" editable="true">
            <input_port name="rfid_status" default="{rfid.status}"/>
        </Condition>
        <Decorator ID="RateController" editable="true">
            <input_port name="hz" default="1.0"/>
        </Decorator>
    </TreeNodesModel>
</root>
