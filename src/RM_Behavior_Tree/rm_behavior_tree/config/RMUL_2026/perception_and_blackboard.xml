<root BTCPP_format="4">
    <BehaviorTree ID="PerceptionAndBlackboard">
        <Sequence>
            <SubRobotStatus topic_name="robot_status"
                            robot_status="{robot_status}"/>
            <DetectRespawnAndSetRecovery
                        topic_name="robot_status"
                        was_dead="{was_dead}"
                        hp_cur="{hp_cur}"
                        need_recovery="{need_recovery}"
                        recovery_start_ms="{recovery_start_ms}"
                        search_start_ms="{search_start_ms}"
                        heal_start_ms="{heal_start_ms}"/>
            <SubGameStatus topic_name="game_status"
                           game_status="{game_status}"/>
            <InitBlackboardConfig
                        heal_wait_ms="{cfg.heal_wait_ms}"
                        heal_min_hp="{cfg.heal_min_hp}"
                        hp_high_threshold="{cfg.hp_high_threshold}"
                        hp_medium_threshold="{cfg.hp_medium_threshold}"
                        search_timeout_ms="{cfg.search_timeout_ms}"
                        recovery_timeout_ms="{cfg.recovery_timeout_ms}"
                        supply_goal_x="{cfg.supply_goal_x}"
                        supply_goal_y="{cfg.supply_goal_y}"
                        control_zone_goal_x="{cfg.control_zone_goal_x}"
                        control_zone_goal_y="{cfg.control_zone_goal_y}"
                        arrive_radius="{cfg.arrive_radius}"/>
            <SubRobotPosition topic_name="robot_position"
                              pose_x="{pose.x}"
                              pose_y="{pose.y}"/>
        </Sequence>
    </BehaviorTree>
</root>