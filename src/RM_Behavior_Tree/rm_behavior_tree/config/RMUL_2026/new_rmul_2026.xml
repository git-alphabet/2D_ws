<?xml version="1.0" encoding="UTF-8"?>
<!--
  new_rmul_2026.xml — 精简版行为树（无脱困逻辑）
  ================================================
  与 rmul_2026.xml 的区别:
    - 删除: keepout 紧急逃离、全局脱困、所有 IsNavigationStuck/FindEscapePoint/FindApproachPoint
    - 删除: B-2 脱困点待命状态
    - 简化: 导航全部改为直接 SendGoal
    - 保留: 全部战术逻辑（感知、标定、HP决策、交战、控制区占领、死亡恢复）
  子树 HighHPCombatLogic / IsDeadAndDispelDebuff 内联在本文件中（同样去除脱困）
-->
<root BTCPP_format="4"
      main_tree_to_execute="MainBehaviorTree">

    <include path="perception_and_blackboard.xml"/>

    <!-- ════════════════════════════════════════════════════════════════
         高血量战斗子树（无脱困版）
         ════════════════════════════════════════════════════════════════ -->
    <BehaviorTree ID="HighHPCombatLogic">
        <ReactiveSequence>
            <IsHPAbove message="{robot_status}" hp_threshold="{cfg.hp_high_threshold}"/>

            <ReactiveFallback>
                <!-- 分支 A: 靠近控制区 + 非回家模式 + 检测到敌人 → 交战 -->
                <ReactiveSequence>
                    <Inverter>
                        <IsRecoveryNeeded need_recovery="{need_recovery}"/>
                    </Inverter>
                    <IsWithinScope pose_x="{pose.x}" pose_y="{pose.y}"
                                   goal_x="{cfg.control_zone_goal_x}" goal_y="{cfg.control_zone_goal_y}"
                                   arrive_radius="{cfg.arrive_radius}"/>
                    <IsDetectEnemy message="{robot_status}"/>

                    <ForceSuccess>
                        <CancelNavGoal action_name="navigate_to_pose" min_interval_ms="1000"/>
                    </ForceSuccess>

                    <Fallback>
                        <!-- A-1: 热量安全 → 刹车+停云台让自瞄接管+小陀螺 -->
                        <Sequence>
                            <IsStatusOK message="{robot_status}"
                                        hp_threshold="0"
                                        heat_threshold="280"/>
                            <NavControlCmd cmd_type="3" emergency_stop="False"/>
                            <RobotControl stop_gimbal_scan="True"
                                          chassis_spin="True"/>
                        </Sequence>
                        <!-- A-2: 热量过高 → 小陀螺闪避等冷却 -->
                        <Sequence>
                            <RobotControl stop_gimbal_scan="False"
                                          chassis_spin="True"/>
                            <NavControlCmd cmd_type="3" emergency_stop="False"/>
                            <KeepRunning/>
                        </Sequence>
                    </Fallback>
                </ReactiveSequence>

                <!-- 分支 B: 未检测到敌人 → 巡逻+占控制区 -->
                <ReactiveFallback>
                    <!-- B-1: 已到达控制区 → 站定搜敌 -->
                    <ReactiveSequence>
                        <IsWithinScope pose_x="{pose.x}" pose_y="{pose.y}"
                                       goal_x="{cfg.control_zone_goal_x}" goal_y="{cfg.control_zone_goal_y}"
                                       arrive_radius="{cfg.arrive_radius}"/>
                        <RobotControl stop_gimbal_scan="False" chassis_spin="True"/>
                        <NavControlCmd cmd_type="3" emergency_stop="False"/>
                        <KeepRunning/>
                    </ReactiveSequence>

                    <!-- B-2: 未到达 → 直接导航前往控制区 -->
                    <ReactiveSequence>
                        <RobotControl stop_gimbal_scan="False" chassis_spin="False"/>
                        <NavControlCmd cmd_type="1" emergency_stop="False"/>
                        <ReactiveFallback name="NavUntilArrived_ControlZone">
                            <IsWithinScope pose_x="{pose.x}" pose_y="{pose.y}"
                                           goal_x="{cfg.control_zone_goal_x}" goal_y="{cfg.control_zone_goal_y}"
                                           arrive_radius="{cfg.arrive_radius}"/>
                            <ReactiveSequence>
                                <RateController hz="1">
                                    <SendGoal name="PatrolControlZone"
                                              goal_x="{cfg.control_zone_goal_x}"
                                              goal_y="{cfg.control_zone_goal_y}"
                                              frame_id="map"
                                              action_name="navigate_to_pose" min_interval_ms="1000"/>
                                </RateController>
                                <KeepRunning/>
                            </ReactiveSequence>
                        </ReactiveFallback>
                    </ReactiveSequence>
                </ReactiveFallback>

            </ReactiveFallback>
        </ReactiveSequence>
    </BehaviorTree>

    <!-- ════════════════════════════════════════════════════════════════
         死亡/恢复子树（无脱困版）
         ════════════════════════════════════════════════════════════════ -->
    <BehaviorTree ID="IsDeadAndDispelDebuff">
        <ReactiveSequence>

            <!-- 0. 每次 tick 都执行：持续跟踪 was_dead / 检测复活沿 -->
            <DetectRespawnAndSetRecovery
                topic_name="robot_status"
                was_dead="{was_dead}"
                hp_cur="{hp_cur}"
                need_recovery="{need_recovery}"
                recovery_start_ms="{recovery_start_ms}"
                search_start_ms="{search_start_ms}"
                heal_start_ms="{heal_start_ms}"/>

            <Fallback>

                <!-- A. 战亡：取消导航+停车等待复活 -->
                <Sequence name="IfDead_StopAndWait">
                    <IsDead message="{robot_status}"/>
                    <ForceSuccess>
                        <CancelNavGoal action_name="navigate_to_pose" min_interval_ms="1000"/>
                    </ForceSuccess>
                    <RobotControl stop_gimbal_scan="True"
                                  chassis_spin="False"/>
                    <NavControlCmd cmd_type="3"
                                   emergency_stop="False"/>
                </Sequence>

                <!-- B. 恢复模式：复活后强制回补给区并回血 -->
                <ReactiveSequence name="RecoveryMode">

                    <IsRecoveryNeeded need_recovery="{need_recovery}"/>

                    <Sequence name="GoSupply_ThenHeal">

                            <!-- 0. 关闭小陀螺 -->
                            <RobotControl stop_gimbal_scan="False"
                                          chassis_spin="False"/>

                            <!-- 1. 启动导航模式 -->
                            <NavControlCmd cmd_type="1" emergency_stop="False"/>

                            <!-- 2. 导航到补给区（直接 SendGoal，无脱困） -->
                            <ReactiveFallback name="NavUntilArrived">
                                <IsWithinScope pose_x="{pose.x}" pose_y="{pose.y}"
                                               goal_x="{cfg.supply_goal_x}" goal_y="{cfg.supply_goal_y}"
                                               arrive_radius="{cfg.arrive_radius}"/>
                                <IsHPIncreasing message="{robot_status}"/>
                                <ReactiveSequence>
                                    <RateController hz="1">
                                        <SendGoal name="GoSupplyToHeal"
                                                  goal_x="{cfg.supply_goal_x}"
                                                  goal_y="{cfg.supply_goal_y}"
                                                  frame_id="map"
                                                  action_name="navigate_to_pose" min_interval_ms="1000"/>
                                    </RateController>
                                    <KeepRunning/>
                                </ReactiveSequence>
                            </ReactiveFallback>

                            <!-- 3. 到达后刹车 -->
                            <RobotControl stop_gimbal_scan="True"
                                          chassis_spin="False"/>
                            <NavControlCmd cmd_type="3"
                                           emergency_stop="False"/>

                            <!-- 4. 等待回血 -->
                            <RetryUntilSuccessful num_attempts="-1">
                                <WaitAndHeal
                                    topic_name="robot_status"
                                    now_ms="{now_ms}"
                                    heal_start_ms="{heal_start_ms}"
                                    heal_wait_ms="{cfg.heal_wait_ms}"
                                    hp_cur="{hp_cur}"
                                    hp_max="{hp_max}"
                                    heal_min_hp="{cfg.heal_min_hp}"/>
                            </RetryUntilSuccessful>

                            <!-- 5. 退出恢复模式 -->
                            <ClearRecoveryFlag
                                need_recovery="{need_recovery}"
                                heal_start_ms="{heal_start_ms}"
                                search_start_ms="{search_start_ms}"
                                recovery_start_ms="{recovery_start_ms}"/>

                    </Sequence>

                </ReactiveSequence>

            </Fallback>

        </ReactiveSequence>
    </BehaviorTree>

    <!-- ════════════════════════════════════════════════════════════════
         主行为树（无脱困版）
         ════════════════════════════════════════════════════════════════ -->
    <BehaviorTree ID="MainBehaviorTree">
        <ReactiveSequence>
            <!-- 订阅数据并写入黑板 -->
            <SubTree ID="PerceptionAndBlackboard" _autoremap="true"/>

            <ForceSuccess>
                <CalibrateCenterAnchor map_frame="map"
                                       base_frame="base_footprint"
                                       manual_only="true"
                                       point_topic="/calib/spawn_point"
                                       force_recalibrate="false"
                                       marker_topic="/calibrated_points"
                                       marker_namespace="spawn_point"
                                       marker_color="black"
                                       marker_id="2001"
                                       center_x="{calib.spawn_x}"
                                       center_y="{calib.spawn_y}"
                                       center_yaw="{calib.spawn_yaw}"
                                       center_valid="{calib.spawn_valid}"
                                       center_pose="{calib.spawn_pose}"/>
            </ForceSuccess>

            <ForceSuccess>
                <CalibrateCenterAnchor map_frame="map"
                                       base_frame="base_footprint"
                                       manual_only="true"
                                       point_topic="/calib/control_point"
                                       force_recalibrate="false"
                                       marker_topic="/calibrated_points"
                                       marker_namespace="control_zone_point"
                                       marker_color="red"
                                       marker_id="2002"
                                       center_x="{calib.anchor_x}"
                                       center_y="{calib.anchor_y}"
                                       center_yaw="{calib.anchor_yaw}"
                                       center_valid="{calib.anchor_valid}"
                                       center_pose="{calib.anchor_pose}"/>
            </ForceSuccess>

            <!-- 标定覆盖 -->
            <ApplyCalibrationOverride
                control_valid="{calib.anchor_valid}"
                control_x="{calib.anchor_x}"
                control_y="{calib.anchor_y}"
                supply_valid="{calib.spawn_valid}"
                supply_x="{calib.spawn_x}"
                supply_y="{calib.spawn_y}"
                control_zone_goal_x="{cfg.control_zone_goal_x}"
                control_zone_goal_y="{cfg.control_zone_goal_y}"
                supply_goal_x="{cfg.supply_goal_x}"
                supply_goal_y="{cfg.supply_goal_y}"/>

            <WhileDoElse>
                <IsGameTime name="IsGameStart"
                        message="{game_status}"
                        robot_msg="{robot_status}"
                    allow_no_game_status_hp_fallback="true"
                        game_progress="4"
                        lower_remain_time="0"
                        higher_remain_time="300"/>
                <!-- 比赛开始后：先强制关闭底盘旋转并停车，等待10秒再执行决策 -->
                <Sequence name="StartupDelay">
                    <RobotControl stop_gimbal_scan="False" chassis_spin="False"/>
                    <NavControlCmd cmd_type="3" emergency_stop="False"/>
                    <Delay delay_msec="10000">
                <ReactiveSequence>
                    <!-- 无脱困分支，直接进入战术逻辑 -->

                    <ReactiveFallback>
                        <!-- 判断战亡/低血量 -->
                        <SubTree ID="IsDeadAndDispelDebuff" _autoremap="true"/>
                        <ExecuteNav2Waypoints action_name="navigate_through_poses"/>
                        <!-- 存活 → 战斗/占点 -->
                        <ReactiveFallback>
                            <!-- 高血量战斗逻辑 -->
                            <SubTree ID="HighHPCombatLogic" _autoremap="true"/>

                            <!-- 非战斗时刻占点：直接导航控制区 -->
                            <ReactiveFallback>
                                <ReactiveFallback>
                                    <!-- 已到达控制区 → 站定搜敌 -->
                                    <ReactiveSequence>
                                        <IsWithinScope pose_x="{pose.x}" pose_y="{pose.y}"
                                                       goal_x="{cfg.control_zone_goal_x}"
                                                       goal_y="{cfg.control_zone_goal_y}"
                                                       arrive_radius="{cfg.arrive_radius}"/>
                                        <RobotControl stop_gimbal_scan="False" chassis_spin="True"/>
                                        <NavControlCmd cmd_type="3" emergency_stop="False"/>
                                        <KeepRunning/>
                                    </ReactiveSequence>

                                    <!-- 未到达 → 导航前往控制区 -->
                                    <ReactiveSequence>
                                        <RobotControl stop_gimbal_scan="False" chassis_spin="False"/>
                                        <NavControlCmd cmd_type="1" emergency_stop="False"/>
                                        <RateController hz="1">
                                            <SendGoal name="GoControlZone"
                                                      goal_x="{cfg.control_zone_goal_x}"
                                                      goal_y="{cfg.control_zone_goal_y}"
                                                      frame_id="map"
                                                      action_name="navigate_to_pose" min_interval_ms="1000"/>
                                        </RateController>
                                        <KeepRunning/>
                                    </ReactiveSequence>
                                </ReactiveFallback>
                            </ReactiveFallback>

                        </ReactiveFallback>
                    </ReactiveFallback>
                </ReactiveSequence>
                    </Delay>
                </Sequence>
                <!-- 非比赛阶段 -->
                <Sequence>
                    <RobotControl stop_gimbal_scan="True" chassis_spin="False"/>
                    <KeepRunning/>
                </Sequence>
            </WhileDoElse>
        </ReactiveSequence>
    </BehaviorTree>

    <!-- TreeNodesModel（仅保留精简版使用到的节点） -->
    <TreeNodesModel>
        <Action ID="ClearCostmap" editable="true">
            <input_port name="service_name" default="local_costmap/clear_entirely"/>
            <input_port name="timeout_ms" default="1000"/>
        </Action>
        <Action ID="ExecuteNav2Waypoints" editable="true">
            <input_port name="action_name" default="follow_waypoints"/>
        </Action>
        <Action ID="SendGoal" editable="true">
            <input_port name="goal_pose" default="{goal_pose}"/>
            <input_port name="goal_x" default="0.0"/>
            <input_port name="goal_y" default="0.0"/>
            <input_port name="frame_id" default="map"/>
            <input_port name="action_name" default="navigate_to_pose"/>
        </Action>
        <Action ID="SubGameStatus" editable="true">
            <input_port name="topic_name" default="game_status"/>
            <output_port name="game_status" default="{game_status}"/>
            <output_port name="now_ms" default="{time.now_ms}"/>
        </Action>
        <Action ID="SubRobotStatus" editable="true">
            <input_port name="topic_name" default="robot_status"/>
            <output_port name="robot_status" default="{robot_status}"/>
        </Action>
        <Action ID="InitBlackboardConfig" editable="true">
            <output_port name="heal_wait_ms" default="{cfg.heal_wait_ms}"/>
            <output_port name="heal_min_hp" default="{cfg.heal_min_hp}"/>
            <output_port name="hp_high_threshold" default="{cfg.hp_high_threshold}"/>
            <output_port name="hp_medium_threshold" default="{cfg.hp_medium_threshold}"/>
            <output_port name="search_timeout_ms" default="{cfg.search_timeout_ms}"/>
            <output_port name="recovery_timeout_ms" default="{cfg.recovery_timeout_ms}"/>
            <output_port name="supply_goal_x" default="{cfg.supply_goal_x}"/>
            <output_port name="supply_goal_y" default="{cfg.supply_goal_y}"/>
            <output_port name="control_zone_goal_x" default="{cfg.control_zone_goal_x}"/>
            <output_port name="control_zone_goal_y" default="{cfg.control_zone_goal_y}"/>
            <output_port name="control_zone_offset_x" default="{cfg.control_zone_offset_x}"/>
            <output_port name="control_zone_offset_y" default="{cfg.control_zone_offset_y}"/>
            <output_port name="arrive_radius" default="{cfg.arrive_radius}"/>
            <output_port name="stuck_check_radius" default="{cfg.stuck_check_radius}"/>
        </Action>
        <Action ID="SubRobotPosition" editable="true">
            <input_port name="topic_name" default="robot_position"/>
            <output_port name="pose_x" default="{pose_x}"/>
            <output_port name="pose_y" default="{pose_y}"/>
        </Action>
        <Action ID="KeepRunning" editable="true"/>
        <Action ID="CancelNavGoal" editable="true">
            <input_port name="action_name" default="navigate_to_pose"/>
        </Action>
        <Action ID="DetectRespawnAndSetRecovery" editable="true">
            <inout_port name="was_dead" default="{state.was_dead}"/>
            <input_port name="hp_cur" default="{hp.cur}"/>
            <input_port name="now_ms" default="{time.now_ms}"/>
            <inout_port name="need_recovery" default="{state.need_recovery}"/>
            <inout_port name="recovery_start_ms" default="{state.recovery_start_ms}"/>
            <inout_port name="search_start_ms" default="{state.search_start_ms}"/>
            <inout_port name="heal_start_ms" default="{state.heal_start_ms}"/>
        </Action>
        <Action ID="ClearRecoveryFlag" editable="true">
            <inout_port name="need_recovery" default="{state.need_recovery}"/>
            <inout_port name="heal_start_ms" default="{state.heal_start_ms}"/>
            <inout_port name="search_start_ms" default="{state.search_start_ms}"/>
            <inout_port name="recovery_start_ms" default="{state.recovery_start_ms}"/>
        </Action>
        <Action ID="WaitAndHeal" editable="true">
            <input_port name="now_ms" default="{time.now_ms}"/>
            <inout_port name="heal_start_ms" default="{state.heal_start_ms}"/>
            <input_port name="heal_wait_ms" default="{cfg.heal_wait_ms}"/>
            <input_port name="hp_cur" default="{hp.cur}"/>
            <input_port name="hp_max" default="{hp.max}"/>
            <input_port name="heal_min_hp" default="{cfg.heal_min_hp}"/>
        </Action>
        <Action ID="RobotControl" editable="true">
            <input_port name="stop_gimbal_scan" default="False"/>
            <input_port name="chassis_spin" default="False"/>
        </Action>
        <Action ID="NavControlCmd" editable="true">
            <input_port name="cmd_type" default="0"/>
            <input_port name="emergency_stop" default="False"/>
        </Action>
        <Action ID="ApplyCalibrationOverride" editable="true">
            <input_port name="control_valid" default="false"/>
            <input_port name="control_x" default="0.0"/>
            <input_port name="control_y" default="0.0"/>
            <input_port name="supply_valid" default="false"/>
            <input_port name="supply_x" default="0.0"/>
            <input_port name="supply_y" default="0.0"/>
            <output_port name="control_zone_goal_x"/>
            <output_port name="control_zone_goal_y"/>
            <output_port name="supply_goal_x"/>
            <output_port name="supply_goal_y"/>
        </Action>
        <Action ID="CalibrateCenterAnchor" editable="true">
            <input_port name="map_frame" default="map"/>
            <input_port name="base_frame" default="base_footprint"/>
            <input_port name="manual_only" default="true"/>
            <input_port name="point_topic"/>
            <input_port name="force_recalibrate" default="false"/>
            <input_port name="marker_topic"/>
            <input_port name="marker_namespace"/>
            <input_port name="marker_color"/>
            <input_port name="marker_id"/>
            <output_port name="center_x"/>
            <output_port name="center_y"/>
            <output_port name="center_yaw"/>
            <output_port name="center_valid"/>
            <output_port name="center_pose"/>
        </Action>
        <Condition ID="IsDetectEnemy" editable="true">
            <input_port name="message" default="{robot_status}"/>
        </Condition>
        <Condition ID="IsGameTime" editable="true">
            <input_port name="message" default="{game_status}"/>
            <input_port name="robot_msg" default="{robot_status}"/>
            <input_port name="allow_no_game_status_hp_fallback" default="false"/>
            <input_port name="game_progress" default="4"/>
            <input_port name="lower_remain_time" default="0"/>
            <input_port name="higher_remain_time" default="300"/>
        </Condition>
        <Condition ID="IsStatusOK" editable="true">
            <input_port name="message" default="{robot_status}"/>
            <input_port name="hp_threshold" default="0"/>
            <input_port name="heat_threshold" default="9999"/>
        </Condition>
        <Condition ID="IsHPAbove" editable="true">
            <input_port name="message" default="{robot_status}"/>
            <input_port name="hp_threshold" default="200"/>
        </Condition>
        <Condition ID="IsHPIncreasing" editable="true">
            <input_port name="message" default="{robot_status}"/>
        </Condition>
        <Condition ID="IsDead" editable="true">
            <input_port name="message" default="{robot_status}"/>
        </Condition>
        <Condition ID="IsRecoveryNeeded" editable="true">
            <input_port name="need_recovery" default="{state.need_recovery}"/>
        </Condition>
        <Condition ID="IsWithinScope" editable="true">
            <input_port name="pose_x" default="{pose.x}"/>
            <input_port name="pose_y" default="{pose.y}"/>
            <input_port name="goal_x" default="{cfg.supply_goal_x}"/>
            <input_port name="goal_y" default="{cfg.supply_goal_y}"/>
            <input_port name="arrive_radius" default="{cfg.arrive_radius}"/>
            <input_port name="use_path_distance" default="false"/>
            <input_port name="plan_topic" default="plan"/>
            <input_port name="goal_match_tolerance" default="1.0"/>
        </Condition>
        <Decorator ID="RateController" editable="true">
            <input_port name="hz" default="1.0"/>
        </Decorator>
    </TreeNodesModel>
</root>
