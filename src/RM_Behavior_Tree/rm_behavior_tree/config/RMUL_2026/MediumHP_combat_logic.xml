<root BTCPP_format="4">
  <!--
    MediumHPCombatLogic — 中血量(200~300)战斗策略
    ================================================================
    设计原则 (RMUL 3v3):
      1. 中血量时生存优先级提升,需要在作战和保命之间平衡
      2. 检测到敌人 → 仍然停车射击（准确率优先），但开启小陀螺增强防护
      3. 热量过高时 → 立即脱离战斗，向补给区撤退
      4. 未检测到敌人 → 向补给区方向靠近，随时准备回血
    ================================================================
  -->
  <BehaviorTree ID="MediumHPCombatLogic">
    <ReactiveSequence>
      <!-- 前置条件: 100 ≤ HP < 200 -->
      <IsHPBelow message="{robot_status}" hp_threshold="200"/>
      <IsHPAbove message="{robot_status}" hp_threshold="100"/>

      <ReactiveFallback>
        <!-- ══════════════════════════════════════════════════════════
             分支 A: 检测到敌人 → 中血量交战
             ══════════════════════════════════════════════════════════ -->
        <ReactiveSequence>
          <IsDetectEnemy message="{robot_status}"/>

          <Fallback>
            <!-- A-1: 热量安全 → 停车射击，精度优先 + 小陀螺防护 -->
            <Sequence>
              <IsStatusOK message="{robot_status}"
                          hp_threshold="0"
                          heat_threshold="200"/>
              <NavControlCmd cmd_type="3" emergency_stop="False"/>
              <RobotControl stop_gimbal_scan="True"
                            chassis_spin="True"/>
            </Sequence>

            <!-- A-2: 热量过高 → 向补给区方向撤退闪避，边走边等冷却
                 中血量热量超限比高血量更危险，需要拉远距离 -->
            <ReactiveSequence>
              <RobotControl stop_gimbal_scan="False"
                            chassis_spin="True"/>
              <NavControlCmd cmd_type="1" emergency_stop="False"/>
              <ReactiveFallback name="NavUntilArrived_Supply">
                <IsWithinScope pose_x="{pose.x}" pose_y="{pose.y}" goal_x="{cfg.supply_goal_x}" goal_y="{cfg.supply_goal_y}" arrive_radius="{cfg.arrive_radius}"/>
                <ReactiveSequence>
                  <RateController hz="1">
                    <Fallback>
                      <Sequence>
                        <SetGoalFromCenterOffset center_x="{calib.spawn_x}"
                                                 center_y="{calib.spawn_y}"
                                                 center_yaw="{calib.spawn_yaw}"
                                                 offset_x="0.0"
                                                 offset_y="0.0"
                                                 goal_x="{nav.goal_x}"
                                                 goal_y="{nav.goal_y}"
                                                 goal_pose="{nav.goal_pose}"/>
                        <SendGoal name="RetreatingToSupply_Calibrated"
                                  goal_pose="{nav.goal_pose}"
                                  frame_id="map"
                                  action_name="navigate_to_pose" min_interval_ms="1000"/>
                      </Sequence>
                      <SendGoal name="RetreatingToSupply_Fallback"
                                goal_x="{cfg.supply_goal_x}"
                                goal_y="{cfg.supply_goal_y}"
                                frame_id="map"
                                action_name="navigate_to_pose" min_interval_ms="1000"/>
                    </Fallback>
                  </RateController>
                  <KeepRunning/>
                </ReactiveSequence>
              </ReactiveFallback>
            </ReactiveSequence>
          </Fallback>
        </ReactiveSequence>

        <!-- ══════════════════════════════════════════════════════════
             分支 B: 未检测到敌人 → 向补给区方向靠近，保持警戒
             说明: 中血量时不再主动进攻控制区，而是靠近补给区
                   以便血量继续下降时能快速到达补给区回血
             ══════════════════════════════════════════════════════════ -->
        <ReactiveSequence>
          <RobotControl stop_gimbal_scan="False"
                        chassis_spin="True"/>
          <NavControlCmd cmd_type="1" emergency_stop="False"/>
          <ReactiveFallback name="NavUntilArrived_Supply">
            <IsWithinScope pose_x="{pose.x}" pose_y="{pose.y}" goal_x="{cfg.supply_goal_x}" goal_y="{cfg.supply_goal_y}" arrive_radius="{cfg.arrive_radius}"/>
            <ReactiveSequence>
              <RateController hz="1">
                <Fallback>
                  <Sequence>
                    <SetGoalFromCenterOffset center_x="{calib.spawn_x}"
                                             center_y="{calib.spawn_y}"
                                             center_yaw="{calib.spawn_yaw}"
                                             offset_x="0.0"
                                             offset_y="0.0"
                                             goal_x="{nav.goal_x}"
                                             goal_y="{nav.goal_y}"
                                             goal_pose="{nav.goal_pose}"/>
                    <SendGoal name="HoverNearSupply_Calibrated"
                              goal_pose="{nav.goal_pose}"
                              frame_id="map"
                              action_name="navigate_to_pose" min_interval_ms="1000"/>
                  </Sequence>
                  <SendGoal name="HoverNearSupply_Fallback"
                            goal_x="{cfg.supply_goal_x}"
                            goal_y="{cfg.supply_goal_y}"
                            frame_id="map"
                            action_name="navigate_to_pose" min_interval_ms="1000"/>
                </Fallback>
              </RateController>
              <KeepRunning/>
            </ReactiveSequence>
          </ReactiveFallback>
        </ReactiveSequence>

      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>
</root>


