<root BTCPP_format="4">
    <!--
      RespawnRecovery 子树 (RMUC 2026 版)
      ======================================
      完全对标 rmul_2026/IsDeadAndDispelDebuff 子树逻辑，
      仅将消息引用从 RMUL.msg 替换为 RMUC.msg。

      功能:
        1. 持续跟踪死亡状态 (was_dead)，检测复活沿
        2. 死亡时停车等待复活读条
        3. 复活后自主导航至补给区，刷卡解除虚弱并回血

      状态机:
        存活(hp>0, no recovery) → FAILURE (正常退出，去战斗)
        死亡(hp=0)             → SUCCESS (停车等待复活)
        复活(was_dead→alive)   → DetectRespawn 置 need_recovery=true
        恢复中(need_recovery)  → SUCCESS (导航补给区→刷卡→回血→清flag)
    -->
    <BehaviorTree ID="RespawnRecovery">
        <Sequence>

            <!-- 0. 每次 tick 都执行：持续跟踪 was_dead / 检测复活沿 -->
            <RmucDetectRespawnAndSetRecovery
                topic_name="/robot_status"
                was_dead="{was_dead}"
                hp_cur="{hp_cur}"
                need_recovery="{need_recovery}"
                recovery_start_ms="{recovery_start_ms}"
                search_start_ms="{search_start_ms}"
                heal_start_ms="{heal_start_ms}"/>

            <!-- 1. 根据当前状态选择分支（两个都 FAILURE = 正常存活，子树 FAILURE） -->
            <Fallback>

                <!-- A. 战亡：停车等待复活读条结束 -->
                <Sequence name="IfDead_StopAndWait">
                    <RmucIsDead message="{robot_status}"/>
                    <RmucRobotControl stop_gimbal_scan="True"
                                  chassis_spin="False"/>
                    <RmucNavControlCmd cmd_type="3"
                                   emergency_stop="False"/>
                </Sequence>

                <!-- B. 恢复模式：复活后强制回补给区刷卡解除虚弱并回血 -->
                <Sequence name="RecoveryMode">

                    <IsRecoveryNeeded need_recovery="{need_recovery}"/>

                    <Fallback name="RecoveryFlow">

                        <!-- 成功分支：检测到补给区RFID → 等待回血 → 清除恢复flag -->
                        <Sequence name="IfSupplyCard_Heal_Exit">
                            <RmucIsSupplyCardDetected rfid_status="{rfid.status}"/>

                            <!-- 等待回血到指定比例 -->
                            <RmucWaitAndHeal
                                topic_name="/robot_status"
                                now_ms="{now_ms}"
                                heal_start_ms="{heal_start_ms}"
                                heal_wait_ms="{cfg.heal_wait_ms}"
                                hp_cur="{hp_cur}"
                                hp_max="{hp_max}"
                                heal_min_ratio="{cfg.heal_min_ratio}"/>

                            <!-- 退出恢复模式 -->
                            <ClearRecoveryFlag
                                need_recovery="{need_recovery}"
                                heal_start_ms="{heal_start_ms}"
                                search_start_ms="{search_start_ms}"
                                recovery_start_ms="{recovery_start_ms}"/>
                        </Sequence>

                        <!-- 失败分支：未检测到卡 → 去补给区 → 到达后微搜 -->
                        <Sequence name="GoSupply_ThenSearch">

                            <!-- 1. 启动导航模式 -->
                            <RmucNavControlCmd cmd_type="1" emergency_stop="False"/>

                            <!-- 2. 导航到补给区（到达前持续RUNNING） -->
                            <ReactiveFallback name="NavUntilArrived">
                                <RmucIsAtNavGoal is_at_nav_goal="{is_at_nav_goal}"/>
                                <ReactiveSequence>
                                    <RateController hz="5">
                                        <SendGoal name="GoSupplyToHeal"
                                            goal_x="{cfg.supply_goal_x}"
                                            goal_y="{cfg.supply_goal_y}"
                                            frame_id="map"
                                            action_name="navigate_to_pose"/>
                                    </RateController>
                                    <KeepRunning/>
                                </ReactiveSequence>
                            </ReactiveFallback>

                            <!-- 3. 到达后刹车+原地不动 -->
                            <RmucRobotControl stop_gimbal_scan="True"
                                          chassis_spin="False"/>
                            <RmucNavControlCmd cmd_type="3"
                                           emergency_stop="False"/>

                            <!-- 4. 初始化搜卡计时器 -->
                            <InitSearchTimerIfNeeded search_start_ms="{search_start_ms}"/>

                            <!-- 5. 先感应补给卡，感应不到再微动搜索 -->
                            <ReactiveFallback name="DetectOrMicroSearch">
                                <RmucIsSupplyCardDetected rfid_status="{rfid.status}"/>
                                <RmucMicroSearchSupplyCard
                                    search_start_ms="{search_start_ms}"
                                    timeout_ms="{cfg.search_timeout_ms}"
                                    rfid_status="{rfid.status}"
                                    rfid_supply_arrived="{rfid.supply_arrived}"/>
                            </ReactiveFallback>

                        </Sequence>

                    </Fallback>

                </Sequence>

            </Fallback>

        </Sequence>
    </BehaviorTree>

</root>
