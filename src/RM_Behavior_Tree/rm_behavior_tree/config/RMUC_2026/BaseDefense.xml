<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

    <BehaviorTree ID="BaseDefense">
        <ReactiveSequence>
            <!-- 判断基地是否受到威胁：base_threat 为 true 或基地当前血量低于最大血量的 50%，否则整棵树不执行 -->
            <IsBaseThreatened base_threat="{threat.base}"
                              base_hp_cur="{base.hp.cur}"
                              base_hp_max="{base.hp.max}"
                              enemy_near_base_radius="{cfg.enemy_near_base_radius}"
                              outpost_alive="{outpost.alive}"/>

            <ReactiveFallback>
                <!-- 检测到敌人 → 停车 + 旋转 + 选目标发布 -->
                <ReactiveSequence>
                    <RmucIsDetectEnemy message="{robot_status}"/>
                    <RmucNavControlCmd cmd_type="3" emergency_stop="False"/>
                    <RmucRobotControl stop_gimbal_scan="False"
                                      chassis_spin="True"/>
                    <SubTree ID="CombatLoop" _autoremap="true"/>
                </ReactiveSequence>

                <!-- 未检测到敌人 → 正常导航到防御锚点，关闭旋转 -->
                <ReactiveSequence>
                    <RmucRobotControl stop_gimbal_scan="False"
                                      chassis_spin="False"/>
                    <RateController hz="1">
                        <SendGoal name="DefendAnchor"
                                  goal_x="{cfg.defend_anchor_x}"
                                  goal_y="{cfg.defend_anchor_y}"
                                  frame_id="map"
                                  action_name="navigate_to_pose"/>
                    </RateController>
                    <KeepRunning/>
                </ReactiveSequence>
            </ReactiveFallback>
        </ReactiveSequence>
    </BehaviorTree>

</root>
