<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

    <BehaviorTree ID="BaseDefense">
        <ReactiveSequence>
            <!-- 判断基地是否受到威胁：base_threat 为 true 或基地当前血量低于最大血量的 50% -->
            <IsBaseThreatened base_threat="{threat.base}"/>

            <!-- 导航到防御锚点 -->
            <RateController hz="1">
                <SendGoal name="DefendAnchor"
                          goal_x="{cfg.defend_anchor_x}"
                          goal_y="{cfg.defend_anchor_y}"
                          frame_id="map"
                          action_name="navigate_to_pose"/>
            </RateController>

            <ReactiveFallback>
                <!-- 在防御点 3.5m 范围内 + 检测到敌人 → 停车对抗 -->
                <ReactiveSequence>
                    <IsAtGoal pose_x="{pose.x}" pose_y="{pose.y}"
                              goal_x="{cfg.defend_anchor_x}" goal_y="{cfg.defend_anchor_y}"
                              arrive_radius="3.5"/>
                    <RmucIsDetectEnemy message="{robot_status}"/>
                    <RmucNavControlCmd cmd_type="3" emergency_stop="False"/>
                    <!-- 底盘旋转由全局 GlobalRobotControl 控制 -->
                    <KeepRunning/>
                </ReactiveSequence>

                <!-- 否则：继续赶路/驻守 -->
                <KeepRunning/>
            </ReactiveFallback>
        </ReactiveSequence>
    </BehaviorTree>

</root>
