<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

    <BehaviorTree ID="EngageCombat">
        <ReactiveSequence>
            <!-- 门控：视觉检测到敌人才执行 -->
            <RmucIsDetectEnemy message="{robot_status}"/>

            <!-- 检测到敌人 → 终止导航，原地站定 -->
            <RmucNavControlCmd cmd_type="3" emergency_stop="False"/>

            <!-- 开启底盘旋转，保持云台扫描 -->
            <RmucRobotControl stop_gimbal_scan="False"
                              chassis_spin="True"/>

            <!-- 选择最优目标并发布给自瞄模块 -->
            <SubTree ID="CombatLoop" _autoremap="true"/>
        </ReactiveSequence>
    </BehaviorTree>

    <!-- ===== 临时 TreeNodesModel：仅用于 Groot2 独立加载，不影响运行时 ===== -->
    <TreeNodesModel>
        <Condition ID="RmucIsDetectEnemy" editable="true">
            <input_port name="message" default="{robot_status}"/>
        </Condition>
        <Action ID="RmucRobotControl" editable="true">
            <input_port name="stop_gimbal_scan" default="False"/>
            <input_port name="chassis_spin" default="False"/>
        </Action>
        <Action ID="RmucNavControlCmd" editable="true">
            <input_port name="cmd_type" default="1"/>
            <input_port name="emergency_stop" default="False"/>
        </Action>
    </TreeNodesModel>
</root>
