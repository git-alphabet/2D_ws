<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

    <BehaviorTree ID="EngageCombat">
        <ReactiveSequence>
            <!-- 门控：视觉检测到敌人才执行 -->
            <RmucIsDetectEnemy message="{robot_status}"
                               is_detect_enemy="{is_detect_enemy}"/>
 
            <!-- 检测到敌人后的导航取消由上层 EnemyDetectionGuard 统一处理 -->
            <!-- 底盘旋转由全局 GlobalRobotControl 控制 -->

            <!-- 保持运行，直到上层条件打断 -->
            <KeepRunning/>
        </ReactiveSequence>
    </BehaviorTree>
</root>
