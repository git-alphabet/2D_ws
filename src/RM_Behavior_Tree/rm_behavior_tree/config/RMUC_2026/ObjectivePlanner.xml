<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

    <BehaviorTree ID="ObjectivePlanner">
        <ReactiveSequence>
            <!-- 姿态由全局 DefaultPosture (rmuc_2026.xml) 统一管理：
                 到达任意导航目标→防御(2)，导航中→移动(3) -->

            <!-- 选择战略目标 (中心高地 / 梯形高地) -->
            <SelectObjective pose_x="{pose.x}" pose_y="{pose.y}"
                             stage_elapsed_time="{game.elapsed_s}"
                             stage_remain_time="{game.remain_s}"
                             hp_cur="{hp.cur}" hp_max="{hp.max}"
                             outpost_alive="{outpost.alive}"
                             enemy_outpost_destroyed="{enemy_outpost_destroyed}"
                             cap_outpost_x="{cfg.cap_outpost_x}"
                             cap_outpost_y="{cfg.cap_outpost_y}"
                             central_highland_x="{cfg.central_highland_x}"
                             central_highland_y="{cfg.central_highland_y}"
                             ladder_highland_x="{cfg.ladder_highland_x}"
                             ladder_highland_y="{cfg.ladder_highland_y}"
                             goal_x="{nav.objective_x}" goal_y="{nav.objective_y}"
                             objective_name="{nav.objective}"/>

            <!-- 巡逻决策：如果前哨站被毁+巡逻开启 → 在目标点和巡逻点间循环 -->
            <ObjectivePatrol pose_x="{pose.x}" pose_y="{pose.y}"
                             objective_x="{nav.objective_x}"
                             objective_y="{nav.objective_y}"
                             objective_name="{nav.objective}"
                             patrol_enable="{cfg.patrol_enable}"
                             patrol_waypoints="{cfg.patrol_waypoints}"
                             patrol_hold_ms="{cfg.patrol_hold_ms}"
                             arrive_radius="{cfg.arrive_radius}"
                             goal_x="{nav.goal_x}" goal_y="{nav.goal_y}"/>

            <!-- 发送导航目标给 Nav2（同一目标默认只发一次，避免密集重发导致崩溃） -->
            <!-- ForceSuccess: 即使 Nav2 导航失败/中止，ObjectivePlanner 也保持活跃 -->
            <!-- max_dedup_ms=0: 同一目标永久去重；只有目标变化或 CancelNavGoal 清缓存后才重发 -->
            <!-- 底盘旋转由全局 GlobalRobotControl 根据 is_at_nav_goal 控制 -->
            <ForceSuccess>
                <RateController hz="1">
                    <SendGoal name="{nav.objective}"
                              goal_x="{nav.goal_x}" goal_y="{nav.goal_y}"
                              frame_id="map" action_name="navigate_to_pose"
                              max_dedup_ms="0"/>
                </RateController>
            </ForceSuccess>
            <KeepRunning/>
        </ReactiveSequence>
    </BehaviorTree>

</root>
