<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

    <BehaviorTree ID="ObjectivePlanner">
        <ReactiveSequence>
            <SelectObjective pose_x="{pose.x}" pose_y="{pose.y}"
                             stage_elapsed_time="{game.elapsed_s}"
                             stage_remain_time="{game.remain_s}"
                             hp_cur="{hp.cur}" hp_max="{hp.max}"
                             ammo_allow="{ammo.allow}"
                             ammo_target="{cfg.ammo_target}"
                             base_hp_cur="{base.hp.cur}" base_hp_max="{base.hp.max}"
                             base_deficit_for_fortress="{cfg.base_deficit_for_fortress}"
                             outpost_alive="{outpost.alive}"
                             base_threat="{threat.base}"
                             field_central_highland="{field.central_highland}"
                             field_ladder_highland="{field.ladder_highland}"
                             field_fortress="{field.fortress}"
                             field_outpost_buff="{field.outpost_buff}"
                             field_base_buff="{field.base_buff}"
                             fortress_ammo="{economy.fortress_ammo}"
                             central_highland_x="{cfg.central_highland_x}"
                             central_highland_y="{cfg.central_highland_y}"
                             ladder_highland_x="{cfg.ladder_highland_x}"
                             ladder_highland_y="{cfg.ladder_highland_y}"
                             base_buff_x="{cfg.base_buff_x}"
                             base_buff_y="{cfg.base_buff_y}"
                             outpost_buff_x="{cfg.outpost_buff_x}"
                             outpost_buff_y="{cfg.outpost_buff_y}"
                             fortress_ally_x="{cfg.fortress_ally_x}"
                             fortress_ally_y="{cfg.fortress_ally_y}"
                             fortress_enemy_x="{cfg.fortress_enemy_x}"
                             fortress_enemy_y="{cfg.fortress_enemy_y}"
                             supply_zone_x="{cfg.supply_zone_x}"
                             supply_zone_y="{cfg.supply_zone_y}"
                             defend_anchor_x="{cfg.defend_anchor_x}"
                             defend_anchor_y="{cfg.defend_anchor_y}"
                             goal_x="{nav.goal_x}" goal_y="{nav.goal_y}"
                             objective_name="{nav.objective}"/>
            <RateController hz="1">
                <SendGoal name="{nav.objective}"
                          goal_x="{nav.goal_x}" goal_y="{nav.goal_y}"
                          frame_id="map" action_name="navigate_to_pose"/>
            </RateController>

            <RmucRobotControl stop_gimbal_scan="False"
                              chassis_spin="False"/>

            <!-- Arrive + ensure card detection (2s invalidation delay exists; node tolerates latency) -->
            <ReactiveFallback>
                <IsAtGoal pose_x="{pose.x}" pose_y="{pose.y}"
                          goal_x="{nav.goal_x}" goal_y="{nav.goal_y}"
                          arrive_radius="{cfg.arrive_radius}"/>
                <KeepRunning/>
            </ReactiveFallback>

            <HoldObjective hold_ms="{cfg.objective_hold_ms}"
                           base_threat="{threat.base}"
                           has_target="{combat.has_target}"/>
        </ReactiveSequence>
    </BehaviorTree>

</root>
