<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

    <BehaviorTree ID="LowHPRetreat">
        <ReactiveSequence>
            <!-- 低血量/死亡 → 移动姿态(3)，加速撤退 -->
            <SelectPosture posture_value="3"
                           posture_out="{cmd.posture}"
                           is_allow_select_posture="{cmd.allow_posture_send}"/>

        <ReactiveFallback>

            <!-- A. 死亡：停车等待复活读条结束（返回 RUNNING 阻塞后续所有子树） -->
            <Sequence name="IfDead_StopAndWait">
                <RmucIsDead message="{robot_status}"/>
                <!-- 底盘旋转/云台由全局 GlobalRobotControl 控制 -->
                <KeepRunning/>
            </Sequence>

            <!-- B. 回血恢复锁存态：导航到补给区回血，直到 hp_safe 才释放 -->
            <ReactiveSequence>
                <ScriptCondition code="need_heal_recovery == true"/>

                <ReactiveFallback>
                    <!-- 分支B1：已在补给区 → 原地等待回血到安全线 -->
                    <ReactiveSequence>
                        <IsAtGoal pose_x="{pose.x}" pose_y="{pose.y}"
                                  goal_x="{cfg.supply_zone_x}" goal_y="{cfg.supply_zone_y}"
                                  arrive_radius="{cfg.arrive_radius}"/>
                        <HoldAndHeal hp_cur="{hp.cur}" hp_max="{hp.max}" hp_safe="{cfg.hp_safe}"
                                     stage_elapsed_time="{game.elapsed_s}"/>
                    </ReactiveSequence>

                    <!-- 分支B2：不在补给区 → 导航到补给区 -->
                    <ReactiveSequence>
                        <RateController hz="1">
                            <SendGoal name="GoSupplyToHeal"
                                      goal_x="{cfg.supply_zone_x}" goal_y="{cfg.supply_zone_y}"
                                      frame_id="map" action_name="navigate_to_pose"/>
                        </RateController>
                        <KeepRunning/>
                    </ReactiveSequence>
                </ReactiveFallback>
            </ReactiveSequence>

        </ReactiveFallback>
        </ReactiveSequence>
    </BehaviorTree>

</root>
