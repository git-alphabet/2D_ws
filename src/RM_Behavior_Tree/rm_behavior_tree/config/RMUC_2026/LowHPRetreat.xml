<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

    <BehaviorTree ID="LowHPRetreat">
        <ReactiveFallback>

            <!-- A. 死亡：停车等待复活读条结束（返回 RUNNING 阻塞后续所有子树） -->
            <Sequence name="IfDead_StopAndWait">
                <RmucIsDead message="{robot_status}"/>
                <!-- 底盘旋转/云台由全局 GlobalRobotControl 控制 -->
                <RmucNavControlCmd cmd_type="3"
                                   emergency_stop="False"/>
                <KeepRunning/>
            </Sequence>

            <!-- B. 低血量：导航到补给区回血 -->
            <ReactiveSequence>
                <!-- 门控：血量低于 hp_low 时才执行 -->
                <RmucIsHPBelow message="{robot_status}" hp_threshold="{cfg.hp_low}"/>

                <ReactiveFallback>
                    <!-- 分支B1：已在补给区 → 原地等待回血到安全线 -->
                    <ReactiveSequence>
                        <IsAtGoal pose_x="{pose.x}" pose_y="{pose.y}"
                                  goal_x="{cfg.supply_zone_x}" goal_y="{cfg.supply_zone_y}"
                                  arrive_radius="{cfg.arrive_radius}"/>
                        <HoldAndHeal hp_cur="{hp.cur}" hp_max="{hp.max}" hp_safe="{cfg.hp_safe}"
                                     stage_elapsed_time="{game.elapsed_s}"/>
                    </ReactiveSequence>

                    <!-- 分支B2：不在补给区 → 导航到补给区 -->
                    <ReactiveSequence>
                        <RateController hz="1">
                            <SendGoal name="GoSupplyToHeal"
                                      goal_x="{cfg.supply_zone_x}" goal_y="{cfg.supply_zone_y}"
                                      frame_id="map" action_name="navigate_to_pose"/>
                        </RateController>
                        <KeepRunning/>
                    </ReactiveSequence>
                </ReactiveFallback>
            </ReactiveSequence>

        </ReactiveFallback>
    </BehaviorTree>

</root>
