<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="rmuc_2026"> 

    <!--
      哨兵自主决策行为树 (BT.CPP v4 XML)
      - 核心：生存能力 + 目标控制 + 经济感知补给 + 姿态管理
      - 基于 RoboMaster 2026 哨兵规则设计：姿态系统、远程兑换、补给回血、堡垒/基地/前哨站增益
      - 所有地图坐标可通过 InitSentryConfig 输出配置
    -->

    <BehaviorTree ID="rmuc_2026">
        <ReactiveSequence>
            <!-- 感知 -> 黑板（应持续 tick；节点预期为非阻塞） -->
            <SubTree ID="PerceptionAndBlackboard" _autoremap="true"/>

            <!-- 初始化配置 + 内部命令状态（幂等；可安全重复 tick） -->
            <SubTree ID="InitOnce" _autoremap="true"/>

            <!-- 比赛阶段循环（7 分钟 = 420 秒） -->
            <WhileDoElse>
                <RmucIsGameTime name="IsMatchStage"
                                message="{game_status}"
                                game_progress="4"
                                lower_remain_time="0"
                                higher_remain_time="420"/>

                <!-- ===================== 比赛阶段 ===================== -->
                <ReactiveSequence>

                    <!-- 构建并按控制速率发送哨兵自主决策指令 (0x0120) -->
                    <SubTree ID="CommandHub" _autoremap="true"/>

                    <!-- 基于优先级的战术 -->
                    <ReactiveFallback>

                        <!-- 0) 死亡 + 复活恢复（RMUC 版：死亡停车 / 复活后自主导航补给区刷卡回血） -->
                        <Sequence>
                            <SetBlackboard output_key="active_subtree" value="RespawnRecovery"/>
                            <SubTree ID="RespawnRecovery" _autoremap="true"/>
                        </Sequence>

                        <!-- 0.5) 虚弱恢复安全网：独立路径，IsWeakness 门控 → 导航最近增益点解除虚弱 -->
                        <Sequence>
                            <SetBlackboard output_key="active_subtree" value="WeaknessRecovery"/>
                            <SubTree ID="WeaknessRecovery" _autoremap="true"/>
                        </Sequence>

                        <!-- 1) 危急生存（血量/热量/电量） -->
                        <Sequence>
                            <SetBlackboard output_key="active_subtree" value="CriticalSurvival"/>
                            <SubTree ID="CriticalSurvival" _autoremap="true"/>
                        </Sequence>

                        <!-- 2) 基地/堡垒防御（受威胁时） -->
                        <Sequence>
                            <SetBlackboard output_key="active_subtree" value="BaseDefense"/>
                            <SubTree ID="BaseDefense" _autoremap="true"/>
                        </Sequence>

                        <!-- 3) 交战（有有效目标且安全时） -->
                        <Sequence>
                            <SetBlackboard output_key="active_subtree" value="EngageCombat"/>
                            <SubTree ID="EngageCombat" _autoremap="true"/>
                        </Sequence>

                        <!-- 4) 后勤：回血/补弹（经济感知） -->
                        <Sequence>
                            <SetBlackboard output_key="active_subtree" value="SustainAndEconomy"/>
                            <SubTree ID="SustainAndEconomy" _autoremap="true"/>
                        </Sequence>

                        <!-- 5) 目标控制：中央高地/梯形高地/堡垒/隧道等 -->
                        <Sequence>
                            <SetBlackboard output_key="active_subtree" value="ObjectivePlanner"/>
                            <SubTree ID="ObjectivePlanner" _autoremap="true"/>
                        </Sequence>

                        <!-- 6) 默认：巡逻扫描 -->
                        <Sequence>
                            <SetBlackboard output_key="active_subtree" value="PatrolAndScan"/>
                            <SubTree ID="PatrolAndScan" _autoremap="true"/>
                        </Sequence>

                    </ReactiveFallback>

                </ReactiveSequence>

                <!-- ===================== 非比赛阶段 ===================== -->
                <ReactiveSequence>
                    <RateController hz="1">
                        <SendGoal name="Home"
                                  goal_x="{cfg.home_x}"
                                  goal_y="{cfg.home_y}"
                                  frame_id="map"
                                  action_name="navigate_to_pose"/>
                    </RateController>
                    <RmucRobotControl stop_gimbal_scan="True"
                                      chassis_spin="False"
                                      fire_enable="False"/>
                    <RateController hz="2">
                        <SentryCmdMux posture="3"
                                      confirm_respawn="0"
                                      confirm_instant_respawn="0"
                                      allow_ammo_target="{cmd.allow_ammo_target}"
                                      trigger_remote_ammo="0"
                                      trigger_remote_hp="0"
                                      enable_big_energy="0"
                                      cmd_state="{cmd.state}"/>
                    </RateController>
                </ReactiveSequence>

            </WhileDoElse>
        </ReactiveSequence>
    </BehaviorTree>

    <!-- ===================== 子树引用 ===================== -->
    <include path="PerceptionAndBlackboard.xml"/>
    <include path="InitOnce.xml"/>
    <include path="CommandHub.xml"/>
    <include path="RespawnRecovery.xml"/>
    <include path="WeaknessRecovery.xml"/>
    <include path="CriticalSurvival.xml"/>
    <include path="BaseDefense.xml"/>
    <include path="EngageCombat.xml"/>
    <include path="CombatLoop.xml"/>
    <include path="SustainAndEconomy.xml"/>
    <include path="HealPlan.xml"/>
    <include path="AmmoPlan.xml"/>
    <include path="ObjectivePlanner.xml"/>
    <include path="PatrolAndScan.xml"/>

    <!-- ===================== 节点模型（供 Groot 使用） ===================== -->
    <TreeNodesModel>

        <!-- 动作：订阅节点 (独立话题) -->
        <Action ID="RmucSubGameStatus" editable="true">
            <input_port name="topic_name" default="/game_status"/>
            <output_port name="game_status" default="{game_status}"/>
            <output_port name="now_ms" default="{time.now_ms}"/>
        </Action>
        <Action ID="RmucSubRobotStatus" editable="true">
            <input_port name="topic_name" default="/robot_status"/>
            <output_port name="robot_status" default="{robot_status}"/>
        </Action>
        <Action ID="RmucSubRFIDStatus" editable="true">
            <input_port name="topic_name" default="/rfid_status"/>
            <output_port name="rfid_status" default="{rfid.status}"/>
        </Action>
        <Action ID="RmucSubRobotPosition" editable="true">
            <input_port name="topic_name" default="/robot_position"/>
            <output_port name="pose_x" default="{pose.x}"/>
            <output_port name="pose_y" default="{pose.y}"/>
            <output_port name="pose_yaw" default="{pose.yaw}"/>
            <output_port name="is_at_nav_goal" default="{is_at_nav_goal}"/>
            <output_port name="pose" default="{pose}"/>
        </Action>
        <Action ID="SubRadarTracks" editable="true">
            <input_port name="topic_name" default="/radar/enemy_tracks"/>
            <output_port name="radar_tracks" default="{radar.tracks}"/>
        </Action>

        <!-- P0 新增: 7 个裁判系统话题订阅节点 -->
        <Action ID="RmucSubSentryDecisionStatus" editable="true">
            <input_port name="topic_name" default="/sentry_decision_status"/>
            <output_port name="sentry_decision_status" default="{sentry_decision_status}"/>
        </Action>
        <Action ID="RmucSubRobotBuff" editable="true">
            <input_port name="topic_name" default="/robot_buff"/>
            <output_port name="robot_buff" default="{robot_buff}"/>
        </Action>
        <Action ID="RmucSubProjectileAllowance" editable="true">
            <input_port name="topic_name" default="/projectile_allowance"/>
            <output_port name="projectile_allowance" default="{projectile_allowance}"/>
        </Action>
        <Action ID="RmucSubFieldStatus" editable="true">
            <input_port name="topic_name" default="/field_status"/>
            <output_port name="field_status" default="{field_status}"/>
        </Action>
        <Action ID="RmucSubEnemyMark" editable="true">
            <input_port name="topic_name" default="/enemy_mark"/>
            <output_port name="enemy_mark" default="{enemy_mark}"/>
        </Action>
        <Action ID="RmucSubTeamPositions" editable="true">
            <input_port name="topic_name" default="/team_positions"/>
            <output_port name="team_positions" default="{team_positions}"/>
        </Action>
        <Action ID="RmucSubTeamHP" editable="true">
            <input_port name="topic_name" default="/team_hp"/>
            <output_port name="team_hp" default="{team_hp}"/>
        </Action>

        <!-- 动作：黑板初始化/解析 -->
        <Action ID="InitSentryConfig" editable="true">
            <output_port name="topic_game_status" default="/game_status"/>
            <output_port name="topic_robot_status" default="/robot_status"/>
            <output_port name="topic_rfid_status" default="/rfid_status"/>
            <output_port name="topic_robot_pose" default="/robot_position"/>
            <output_port name="topic_radar_tracks" default="/radar/enemy_tracks"/>

            <!-- TODO: 以下所有坐标需根据实际地图填写（单位：米，map 坐标系） -->
            <output_port name="home_x" default="0.0"/>          <!-- TODO: 己方出生点/复活点 x -->
            <output_port name="home_y" default="0.0"/>          <!-- TODO: 己方出生点/复活点 y -->
            <output_port name="supply_zone_x" default="0.0"/>     <!-- TODO: 补给区坐标 x (RFID刷卡 + 导航 + 选点 统一使用) -->
            <output_port name="supply_zone_y" default="0.0"/>     <!-- TODO: 补给区坐标 y (RFID刷卡 + 导航 + 选点 统一使用) -->
            <output_port name="base_buff_x" default="0.0"/>     <!-- TODO: 己方基地增益区中心 x -->
            <output_port name="base_buff_y" default="0.0"/>     <!-- TODO: 己方基地增益区中心 y -->
            <output_port name="outpost_buff_x" default="0.0"/>  <!-- TODO: 己方前哨站增益区中心 x -->
            <output_port name="outpost_buff_y" default="0.0"/>  <!-- TODO: 己方前哨站增益区中心 y -->
            <output_port name="fortress_ally_x" default="0.0"/> <!-- TODO: 己方堡垒区中心 x -->
            <output_port name="fortress_ally_y" default="0.0"/> <!-- TODO: 己方堡垒区中心 y -->
            <output_port name="fortress_enemy_x" default="0.0"/><!-- TODO: 敌方堡垒区中心 x -->
            <output_port name="fortress_enemy_y" default="0.0"/><!-- TODO: 敌方堡垒区中心 y -->
            <output_port name="central_highland_x" default="0.0"/> <!-- TODO: 中央高地中心 x -->
            <output_port name="central_highland_y" default="0.0"/> <!-- TODO: 中央高地中心 y -->
            <output_port name="ladder_highland_x" default="0.0"/>  <!-- TODO: 阶梯高地中心 x -->
            <output_port name="ladder_highland_y" default="0.0"/>  <!-- TODO: 阶梯高地中心 y -->
            <output_port name="defend_anchor_x" default="0.0"/> <!-- TODO: 防御锚点（基地前守卫位置） x -->
            <output_port name="defend_anchor_y" default="0.0"/> <!-- TODO: 防御锚点（基地前守卫位置） y -->

            <output_port name="patrol_wpt_0_x" default="0.0"/>  <!-- TODO: 巡逻路点 0 x -->
            <output_port name="patrol_wpt_0_y" default="0.0"/>  <!-- TODO: 巡逻路点 0 y -->
            <output_port name="patrol_wpt_1_x" default="0.0"/>  <!-- TODO: 巡逻路点 1 x -->
            <output_port name="patrol_wpt_1_y" default="0.0"/>  <!-- TODO: 巡逻路点 1 y -->
            <output_port name="patrol_wpt_2_x" default="0.0"/>  <!-- TODO: 巡逻路点 2 x -->
            <output_port name="patrol_wpt_2_y" default="0.0"/>

            <output_port name="arrive_radius" default="0.35"/>
            <output_port name="hp_critical" default="80"/>
            <output_port name="hp_low" default="180"/>
            <output_port name="hp_safe" default="280"/>
            <output_port name="heat_high" default="210"/>
            <output_port name="heat_critical" default="245"/>
            <output_port name="ammo_low" default="80"/>
            <output_port name="ammo_target" default="300"/>
            <output_port name="base_deficit_for_fortress" default="500"/>
            <output_port name="enemy_near_base_radius" default="2.0"/>
            <output_port name="objective_hold_ms" default="12000"/>
            <output_port name="combat_fire_burst_ms" default="180"/>
            <output_port name="combat_fire_pause_ms" default="120"/>
            <!-- RespawnRecovery 恢复流程配置 -->
            <output_port name="heal_wait_ms" default="3000"/>   <!-- 刷卡后等待回血的最长时间(ms) -->
            <output_port name="heal_min_ratio" default="0.6"/>  <!-- 最低回血比例才退出 -->
            <output_port name="search_timeout_ms" default="5000"/> <!-- 微搜卡超时(ms) -->
        </Action>

        <Action ID="InitCmdState" editable="true">
            <inout_port name="cmd_state" default="{cmd.state}"/>
            <inout_port name="allow_ammo_target" default="{cmd.allow_ammo_target}"/>
        </Action>

        <Action ID="ParseSentryBlackboard" editable="true">
            <input_port name="game_status" default="{game_status}"/>
            <input_port name="robot_status" default="{robot_status}"/>
            <input_port name="radar_tracks" default="{radar.tracks}"/>
            <input_port name="pose_x" default="{pose.x}"/>
            <input_port name="pose_y" default="{pose.y}"/>
            <input_port name="now_ms" default="{time.now_ms}"/>
            <!-- P0 新增 inputs: 7 个新话题 -->
            <input_port name="sentry_decision_status" default="{sentry_decision_status}"/>
            <input_port name="robot_buff" default="{robot_buff}"/>
            <input_port name="projectile_allowance" default="{projectile_allowance}"/>
            <input_port name="field_status" default="{field_status}"/>
            <input_port name="enemy_mark" default="{enemy_mark}"/>
            <input_port name="team_positions" default="{team_positions}"/>
            <input_port name="team_hp" default="{team_hp}"/>

            <output_port name="stage_remain_time" default="{game.remain_s}"/>
            <output_port name="stage_elapsed_time" default="{game.elapsed_s}"/>
            <output_port name="hp_cur" default="{hp.cur}"/>
            <output_port name="hp_max" default="{hp.max}"/>
            <output_port name="heat_cur" default="{heat.cur}"/>
            <output_port name="ammo_allow" default="{ammo.allow}"/>
            <output_port name="ammo_left" default="{ammo.left}"/>
            <output_port name="base_hp_cur" default="{base.hp.cur}"/>
            <output_port name="base_hp_max" default="{base.hp.max}"/>
            <output_port name="outpost_alive" default="{outpost.alive}"/>
            <output_port name="is_dead" default="{state.is_dead}"/>
            <output_port name="is_disengaged" default="{state.disengaged}"/>
            <output_port name="disengage_countdown" default="{state.disengage_cd_s}"/>
            <output_port name="can_remote_heal" default="{economy.can_remote_heal}"/>
            <output_port name="can_remote_ammo" default="{economy.can_remote_ammo}"/>
            <output_port name="team_coins" default="{economy.coins}"/>
            <output_port name="has_target" default="{combat.has_target}"/>
            <output_port name="best_target" default="{combat.best_target}"/>
            <output_port name="base_threat" default="{threat.base}"/>
            <output_port name="fortress_threat" default="{threat.fortress}"/>
            <!-- P0 新增 outputs: 0x020D -->
            <output_port name="can_free_respawn" default="{sentry.can_free_respawn}"/>
            <output_port name="can_instant_respawn" default="{sentry.can_instant_respawn}"/>
            <output_port name="instant_respawn_cost" default="{sentry.instant_respawn_cost}"/>
            <output_port name="current_posture" default="{sentry.current_posture}"/>
            <output_port name="remote_ammo_count" default="{sentry.remote_ammo_count}"/>
            <output_port name="remote_heal_count" default="{sentry.remote_heal_count}"/>
            <output_port name="exchanged_ammo_total" default="{sentry.exchanged_ammo_total}"/>
            <output_port name="can_activate_energy" default="{sentry.can_activate_energy}"/>
            <!-- P0 新增 outputs: 0x0204 -->
            <output_port name="buff_heal_rate" default="{buff.heal_rate}"/>
            <output_port name="buff_cool_value" default="{buff.cool_value}"/>
            <output_port name="buff_defense_pct" default="{buff.defense_pct}"/>
            <output_port name="buff_vulnerability_pct" default="{buff.vulnerability_pct}"/>
            <output_port name="buff_attack_pct" default="{buff.attack_pct}"/>
            <!-- P0 新增 outputs: 0x0208 -->
            <output_port name="fortress_ammo" default="{economy.fortress_ammo}"/>
            <!-- P0 新增 outputs: 0x0101 -->
            <output_port name="field_central_highland" default="{field.central_highland}"/>
            <output_port name="field_ladder_highland" default="{field.ladder_highland}"/>
            <output_port name="field_fortress" default="{field.fortress}"/>
            <output_port name="field_outpost_buff" default="{field.outpost_buff}"/>
            <output_port name="field_base_buff" default="{field.base_buff}"/>
            <output_port name="field_small_energy" default="{field.small_energy}"/>
            <output_port name="field_big_energy" default="{field.big_energy}"/>
            <!-- P0 新增 outputs: 0x020C -->
            <output_port name="enemy_hero_vuln" default="{enemy.hero_vuln}"/>
            <output_port name="enemy_engi_vuln" default="{enemy.engi_vuln}"/>
            <output_port name="enemy_infantry3_vuln" default="{enemy.infantry3_vuln}"/>
            <output_port name="enemy_infantry4_vuln" default="{enemy.infantry4_vuln}"/>
            <output_port name="enemy_sentry_vuln" default="{enemy.sentry_vuln}"/>
            <!-- P0 新增 outputs: 0x0003 -->
            <output_port name="team_outpost_hp" default="{team.outpost_hp}"/>
            <output_port name="team_base_hp" default="{team.base_hp}"/>
            <!-- P1 新增 outputs: 复活/虚弱状态窗口 -->
            <output_port name="is_respawn_invincible" default="{state.respawn_invincible}"/>
            <output_port name="respawn_invincible_remain_s" default="{state.respawn_invincible_remain_s}"/>
            <output_port name="is_power_boosted" default="{state.power_boosted}"/>
            <output_port name="power_boost_remain_s" default="{state.power_boost_remain_s}"/>
            <inout_port name="cumulative_instant_count" default="{respawn.cum_instant_count}"/>
        </Action>

        <!-- 动作：决策节点 -->
        <Action ID="DecidePosture" editable="true">
            <input_port name="hp_cur" default="{hp.cur}"/>
            <input_port name="hp_max" default="{hp.max}"/>
            <input_port name="heat_cur" default="{heat.cur}"/>
            <input_port name="heat_high" default="{cfg.heat_high}"/>
            <input_port name="has_target" default="{combat.has_target}"/>
            <input_port name="base_threat" default="{threat.base}"/>
            <input_port name="is_disengaged" default="{state.disengaged}"/>
            <input_port name="stage_elapsed_time" default="{game.elapsed_s}"/>
            <input_port name="now_ms" default="{time.now_ms}"/>
            <!-- P4 新增 -->
            <input_port name="active_subtree" default=""/>
            <input_port name="current_posture" default="{sentry.current_posture}"/>
            <input_port name="buff_cool_value" default="{buff.cool_value}"/>
            <input_port name="buff_defense_pct" default="{buff.defense_pct}"/>
            <input_port name="buff_vulnerability_pct" default="{buff.vulnerability_pct}"/>
            <input_port name="ammo_allow" default="{ammo.allow}"/>
            <output_port name="posture_out" default="{cmd.posture}"/>
        </Action>

        <Action ID="DecideEconomyCmd" editable="true">
            <input_port name="hp_cur" default="{hp.cur}"/>
            <input_port name="hp_max" default="{hp.max}"/>
            <input_port name="ammo_allow" default="{ammo.allow}"/>
            <input_port name="ammo_target" default="{cfg.ammo_target}"/>
            <input_port name="ammo_low" default="{cfg.ammo_low}"/>
            <input_port name="is_disengaged" default="{state.disengaged}"/>
            <input_port name="can_remote_heal" default="{economy.can_remote_heal}"/>
            <input_port name="can_remote_ammo" default="{economy.can_remote_ammo}"/>
            <input_port name="team_coins" default="{economy.coins}"/>
            <input_port name="stage_remain_time" default="{game.remain_s}"/>
            <input_port name="base_threat" default="{threat.base}"/>
            <!-- P2 新增 inputs -->
            <input_port name="instant_respawn_cost" default="{sentry.instant_respawn_cost}"/>
            <input_port name="cumulative_instant_count" default="{respawn.cum_instant_count}"/>
            <input_port name="base_hp_cur" default="{base.hp.cur}"/>
            <input_port name="base_hp_max" default="{base.hp.max}"/>
            <input_port name="fortress_ammo" default="{economy.fortress_ammo}"/>
            <input_port name="remote_heal_count" default="{sentry.remote_heal_count}"/>
            <input_port name="remote_ammo_count" default="{sentry.remote_ammo_count}"/>
            <input_port name="allow_ammo_target_in" default="{cmd.allow_ammo_target}"/>
            <output_port name="allow_ammo_target_out" default="{cmd.allow_ammo_target}"/>
            <output_port name="trigger_remote_ammo" default="{cmd.trig_remote_ammo}"/>
            <output_port name="trigger_remote_hp" default="{cmd.trig_remote_hp}"/>
            <output_port name="enable_big_energy" default="{cmd.enable_big_energy}"/>
        </Action>

        <Action ID="DecideRespawnCmd" editable="true">
            <input_port name="is_dead" default="{state.is_dead}"/>
            <input_port name="robot_status" default="{robot_status}"/>
            <input_port name="team_coins" default="{economy.coins}"/>
            <input_port name="stage_remain_time" default="{game.remain_s}"/>
            <input_port name="base_hp_cur" default="{base.hp.cur}"/>
            <input_port name="base_hp_max" default="{base.hp.max}"/>
            <input_port name="base_threat" default="{threat.base}"/>
            <!-- P1 新增: 复活可用性 (from 0x020D) -->
            <input_port name="can_free_respawn" default="{sentry.can_free_respawn}"/>
            <input_port name="can_instant_respawn" default="{sentry.can_instant_respawn}"/>
            <input_port name="instant_respawn_cost" default="{sentry.instant_respawn_cost}"/>
            <!-- P1 新增: 累计立即复活次数 (影响复活倒计时公式) -->
            <inout_port name="cumulative_instant_count" default="{respawn.cum_instant_count}"/>
            <output_port name="confirm_respawn" default="{cmd.confirm_respawn}"/>
            <output_port name="confirm_instant_respawn" default="{cmd.confirm_instant_respawn}"/>
        </Action>

        <!-- 动作：裁判系统指令复用器 (0x0120) -->
        <Action ID="SentryCmdMux" editable="true">
            <input_port name="posture" default="3"/>
            <input_port name="confirm_respawn" default="0"/>
            <input_port name="confirm_instant_respawn" default="0"/>
            <input_port name="allow_ammo_target" default="{cmd.allow_ammo_target}"/>
            <input_port name="trigger_remote_ammo" default="0"/>
            <input_port name="trigger_remote_hp" default="0"/>
            <input_port name="enable_big_energy" default="0"/>
            <inout_port name="cmd_state" default="{cmd.state}"/>
        </Action>

        <!-- 动作：导航节点 -->
        <Action ID="SendGoal" editable="true">
            <input_port name="goal_x" default="0.0"/>
            <input_port name="goal_y" default="0.0"/>
            <input_port name="frame_id" default="map"/>
            <input_port name="action_name" default="navigate_to_pose"/>
        </Action>
        <Action ID="CancelNavGoal" editable="true">
            <input_port name="action_name" default="navigate_to_pose"/>
        </Action>

        <Action ID="MoveAround" editable="true">
            <input_port name="expected_nearby_goal_count" default="5"/>
            <input_port name="expected_dis" default="0.25"/>
            <input_port name="message" default="{pose}"/>
        </Action>
        <Action ID="KeepRunning" editable="true"/>

        <!-- 动作：战斗节点 -->
        <Action ID="SelectBestTarget" editable="true">
            <input_port name="radar_tracks" default="{radar.tracks}"/>
            <input_port name="pose_x" default="{pose.x}"/>
            <input_port name="pose_y" default="{pose.y}"/>
            <input_port name="base_x" default="{cfg.base_buff_x}"/>
            <input_port name="base_y" default="{cfg.base_buff_y}"/>
            <!-- P3 补充7: 敌方易伤 (0x020C) -->
            <input_port name="enemy_hero_vuln" default="{enemy.hero_vuln}"/>
            <input_port name="enemy_engi_vuln" default="{enemy.engi_vuln}"/>
            <input_port name="enemy_infantry3_vuln" default="{enemy.infantry3_vuln}"/>
            <input_port name="enemy_infantry4_vuln" default="{enemy.infantry4_vuln}"/>
            <input_port name="enemy_sentry_vuln" default="{enemy.sentry_vuln}"/>
            <output_port name="out_target" default="{combat.best_target}"/>
        </Action>
        <Action ID="AimAtTarget" editable="true">
            <input_port name="target" default="{combat.best_target}"/>
        </Action>
        <Action ID="FireBurst" editable="true">
            <input_port name="burst_ms" default="{cfg.combat_fire_burst_ms}"/>
            <input_port name="pause_ms" default="{cfg.combat_fire_pause_ms}"/>
        </Action>

        <Action ID="RmucRobotControl" editable="true">
            <input_port name="stop_gimbal_scan" default="False"/>
            <input_port name="chassis_spin" default="False"/>
            <input_port name="fire_enable" default="False"/>
        </Action>

        <!-- 动作：目标/工具节点 -->
        <Action ID="SelectObjective" editable="true">
            <input_port name="pose_x" default="{pose.x}"/>
            <input_port name="pose_y" default="{pose.y}"/>
            <input_port name="stage_elapsed_time" default="{game.elapsed_s}"/>
            <input_port name="stage_remain_time" default="{game.remain_s}"/>
            <input_port name="hp_cur" default="{hp.cur}"/>
            <input_port name="hp_max" default="{hp.max}"/>
            <input_port name="ammo_allow" default="{ammo.allow}"/>
            <input_port name="ammo_target" default="{cfg.ammo_target}"/>
            <input_port name="base_hp_cur" default="{base.hp.cur}"/>
            <input_port name="base_hp_max" default="{base.hp.max}"/>
            <input_port name="base_deficit_for_fortress" default="{cfg.base_deficit_for_fortress}"/>
            <input_port name="outpost_alive" default="{outpost.alive}"/>
            <input_port name="base_threat" default="{threat.base}"/>
            <!-- P3 新增: 占领状态 (0x0101) -->
            <input_port name="field_central_highland" default="{field.central_highland}"/>
            <input_port name="field_ladder_highland" default="{field.ladder_highland}"/>
            <input_port name="field_fortress" default="{field.fortress}"/>
            <input_port name="field_outpost_buff" default="{field.outpost_buff}"/>
            <input_port name="field_base_buff" default="{field.base_buff}"/>
            <!-- P3 新增: 堡垒弹量 -->
            <input_port name="fortress_ammo" default="{economy.fortress_ammo}"/>
            <!-- 各候选点坐标 -->
            <input_port name="central_highland_x" default="{cfg.central_highland_x}"/>
            <input_port name="central_highland_y" default="{cfg.central_highland_y}"/>
            <input_port name="ladder_highland_x" default="{cfg.ladder_highland_x}"/>
            <input_port name="ladder_highland_y" default="{cfg.ladder_highland_y}"/>
            <input_port name="base_buff_x" default="{cfg.base_buff_x}"/>
            <input_port name="base_buff_y" default="{cfg.base_buff_y}"/>
            <input_port name="outpost_buff_x" default="{cfg.outpost_buff_x}"/>
            <input_port name="outpost_buff_y" default="{cfg.outpost_buff_y}"/>
            <input_port name="fortress_ally_x" default="{cfg.fortress_ally_x}"/>
            <input_port name="fortress_ally_y" default="{cfg.fortress_ally_y}"/>
            <input_port name="fortress_enemy_x" default="{cfg.fortress_enemy_x}"/>
            <input_port name="fortress_enemy_y" default="{cfg.fortress_enemy_y}"/>
            <input_port name="supply_zone_x" default="{cfg.supply_zone_x}"/>
            <input_port name="supply_zone_y" default="{cfg.supply_zone_y}"/>
            <input_port name="defend_anchor_x" default="{cfg.defend_anchor_x}"/>
            <input_port name="defend_anchor_y" default="{cfg.defend_anchor_y}"/>
            <output_port name="goal_x" default="{nav.goal_x}"/>
            <output_port name="goal_y" default="{nav.goal_y}"/>
            <output_port name="objective_name" default="{nav.objective}"/>
        </Action>

        <Action ID="HoldObjective" editable="true">
            <input_port name="hold_ms" default="{cfg.objective_hold_ms}"/>
            <input_port name="base_threat" default="{threat.base}"/>
            <input_port name="has_target" default="{combat.has_target}"/>
        </Action>

        <Action ID="WaypointPatrol" editable="true">
            <input_port name="pose_x" default="{pose.x}"/>
            <input_port name="pose_y" default="{pose.y}"/>
            <input_port name="wpt0_x" default="{cfg.patrol.0.x}"/>
            <input_port name="wpt0_y" default="{cfg.patrol.0.y}"/>
            <input_port name="wpt1_x" default="{cfg.patrol.1.x}"/>
            <input_port name="wpt1_y" default="{cfg.patrol.1.y}"/>
            <input_port name="wpt2_x" default="{cfg.patrol.2.x}"/>
            <input_port name="wpt2_y" default="{cfg.patrol.2.y}"/>
            <output_port name="goal_x" default="{nav.goal_x}"/>
            <output_port name="goal_y" default="{nav.goal_y}"/>
        </Action>

        <Action ID="SelectNearestDispelCard" editable="true">
            <input_port name="pose_x" default="{pose.x}"/>
            <input_port name="pose_y" default="{pose.y}"/>
            <input_port name="supply_zone_x" default="{cfg.supply_zone_x}"/>
            <input_port name="supply_zone_y" default="{cfg.supply_zone_y}"/>
            <input_port name="base_buff_x" default="{cfg.base_buff_x}"/>
            <input_port name="base_buff_y" default="{cfg.base_buff_y}"/>
            <input_port name="outpost_buff_x" default="{cfg.outpost_buff_x}"/>
            <input_port name="outpost_buff_y" default="{cfg.outpost_buff_y}"/>
            <output_port name="goal_x" default="{nav.goal_x}"/>
            <output_port name="goal_y" default="{nav.goal_y}"/>
        </Action>

        <Action ID="SelectNearestResupplyStation" editable="true">
            <input_port name="pose_x" default="{pose.x}"/>
            <input_port name="pose_y" default="{pose.y}"/>
            <input_port name="supply_zone_x" default="{cfg.supply_zone_x}"/>
            <input_port name="supply_zone_y" default="{cfg.supply_zone_y}"/>
            <input_port name="base_buff_x" default="{cfg.base_buff_x}"/>
            <input_port name="base_buff_y" default="{cfg.base_buff_y}"/>
            <input_port name="outpost_buff_x" default="{cfg.outpost_buff_x}"/>
            <input_port name="outpost_buff_y" default="{cfg.outpost_buff_y}"/>
            <output_port name="goal_x" default="{nav.goal_x}"/>
            <output_port name="goal_y" default="{nav.goal_y}"/>
        </Action>

        <Action ID="SelectSafeRetreatGoal" editable="true">
            <input_port name="pose_x" default="{pose.x}"/>
            <input_port name="pose_y" default="{pose.y}"/>
            <input_port name="supply_zone_x" default="{cfg.supply_zone_x}"/>
            <input_port name="supply_zone_y" default="{cfg.supply_zone_y}"/>
            <input_port name="defend_anchor_x" default="{cfg.defend_anchor_x}"/>
            <input_port name="defend_anchor_y" default="{cfg.defend_anchor_y}"/>
            <output_port name="goal_x" default="{nav.goal_x}"/>
            <output_port name="goal_y" default="{nav.goal_y}"/>
        </Action>

        <Action ID="HoldAndHeal" editable="true">
            <input_port name="hp_cur" default="{hp.cur}"/>
            <input_port name="hp_max" default="{hp.max}"/>
            <input_port name="hp_safe" default="{cfg.hp_safe}"/>
            <input_port name="stage_elapsed_time" default="{game.elapsed_s}"/>
            <input_port name="is_disengaged" default="{state.disengaged}"/>
        </Action>

        <Action ID="HoldForSupplyAmmoTick" editable="true">
            <input_port name="stage_elapsed_time" default="{game.elapsed_s}"/>
            <input_port name="ammo_allow" default="{ammo.allow}"/>
            <input_port name="ammo_target" default="{cfg.ammo_target}"/>
        </Action>

        <!-- 条件节点 -->
        <Condition ID="RmucIsGameTime" editable="true">
            <input_port name="message" default="{game_status}"/>
            <input_port name="game_progress" default="4"/>
            <input_port name="lower_remain_time" default="0"/>
            <input_port name="higher_remain_time" default="420"/>
        </Condition>
        <Condition ID="RmucIsDead" editable="true">
            <input_port name="message" default="{robot_status}"/>
        </Condition>
        <Condition ID="IsWeakness" editable="true">
            <input_port name="robot_status" default="{robot_status}"/>
        </Condition>
        <Condition ID="RmucIsHPBelow" editable="true">
            <input_port name="message" default="{robot_status}"/>
            <input_port name="hp_threshold" default="{cfg.hp_low}"/>
        </Condition>

        <Condition ID="IsAmmoBelow" editable="true">
            <input_port name="ammo_allow" default="{ammo.allow}"/>
            <input_port name="ammo_low" default="{cfg.ammo_low}"/>
        </Condition>

        <Condition ID="IsCriticalState" editable="true">
            <input_port name="hp_cur" default="{hp.cur}"/>
            <input_port name="hp_critical" default="{cfg.hp_critical}"/>
            <input_port name="heat_cur" default="{heat.cur}"/>
            <input_port name="heat_critical" default="{cfg.heat_critical}"/>
        </Condition>

        <Condition ID="IsBaseThreatened" editable="true">
            <input_port name="base_threat" default="{threat.base}"/>
            <input_port name="base_hp_cur" default="{base.hp.cur}"/>
            <input_port name="base_hp_max" default="{base.hp.max}"/>
            <input_port name="enemy_near_base_radius" default="{cfg.enemy_near_base_radius}"/>
            <!-- P3 补充4: 前哨站存活 → 基地无敌 → 降低威胁敏感度 -->
            <input_port name="outpost_alive" default="{outpost.alive}"/>
        </Condition>

        <Condition ID="HasValidTarget" editable="true">
            <input_port name="has_target" default="{combat.has_target}"/>
            <input_port name="best_target" default="{combat.best_target}"/>
        </Condition>

        <Condition ID="IsCombatAllowed" editable="true">
            <input_port name="robot_status" default="{robot_status}"/>
            <input_port name="ammo_allow" default="{ammo.allow}"/>
            <input_port name="heat_cur" default="{heat.cur}"/>
            <input_port name="heat_high" default="{cfg.heat_high}"/>
            <input_port name="hp_cur" default="{hp.cur}"/>
            <input_port name="hp_low" default="{cfg.hp_low}"/>
        </Condition>

        <Condition ID="IsFireWindowOk" editable="true">
            <input_port name="heat_cur" default="{heat.cur}"/>
            <input_port name="heat_high" default="{cfg.heat_high}"/>
            <input_port name="ammo_allow" default="{ammo.allow}"/>
            <input_port name="robot_status" default="{robot_status}"/>
            <!-- P4 新增 -->
            <input_port name="current_posture" default="{sentry.current_posture}"/>
            <input_port name="buff_cool_value" default="{buff.cool_value}"/>
            <input_port name="buff_vulnerability_pct" default="{buff.vulnerability_pct}"/>
            <input_port name="ammo_conserve" default="30"/>
        </Condition>

        <Condition ID="IsZoneCardDetected" editable="true">
            <input_port name="zone" default="SUPPLY"/>
            <input_port name="rfid_status" default="{rfid.status}"/>
            <input_port name="robot_status" default="{robot_status}"/>
        </Condition>

        <!-- P4: 底盘旋转策略 (导航中禁止旋转, 到达目标站定攻击时按姿态决定) -->
        <Condition ID="ShouldChassisSpin" editable="true">
            <input_port name="pose_x" default="{pose.x}"/>
            <input_port name="pose_y" default="{pose.y}"/>
            <input_port name="goal_x" default="{nav.goal_x}"/>
            <input_port name="goal_y" default="{nav.goal_y}"/>
            <input_port name="arrive_radius" default="{cfg.arrive_radius}"/>
            <input_port name="current_posture" default="{sentry.current_posture}"/>
            <input_port name="is_power_boosted" default="{state.power_boosted}"/>
            <input_port name="force_spin" default="false"/>
        </Condition>

        <Condition ID="IsAnyDispelCardDetected" editable="true">
            <input_port name="rfid_status" default="{rfid.status}"/>
            <input_port name="robot_status" default="{robot_status}"/>
        </Condition>

        <Condition ID="IsAtGoal" editable="true">
            <input_port name="pose_x" default="{pose.x}"/>
            <input_port name="pose_y" default="{pose.y}"/>
            <input_port name="goal_x" default="{nav.goal_x}"/>
            <input_port name="goal_y" default="{nav.goal_y}"/>
            <input_port name="arrive_radius" default="{cfg.arrive_radius}"/>
        </Condition>

        <!-- 装饰器节点 -->
        <Decorator ID="RateController" editable="true">
            <input_port name="hz" default="1.0"/>
        </Decorator>

        <!-- RespawnRecovery 相关节点 -->
        <Action ID="RmucNavControlCmd" editable="true">
            <input_port name="cmd_type" default="1"/>
            <input_port name="emergency_stop" default="False"/>
        </Action>
        <Action ID="RmucWaitAndHeal" editable="true">
            <input_port name="topic_name" default="/robot_status"/>
            <input_port name="now_ms" default="{time.now_ms}"/>
            <input_port name="hp_cur" default="{hp.cur}"/>
            <input_port name="hp_max" default="{hp.max}"/>
            <inout_port name="heal_start_ms" default="{heal_start_ms}"/>
            <input_port name="heal_wait_ms" default="{cfg.heal_wait_ms}"/>
            <input_port name="heal_min_ratio" default="{cfg.heal_min_ratio}"/>
        </Action>
        <Action ID="InitSearchTimerIfNeeded" editable="true">
            <inout_port name="search_start_ms" default="{search_start_ms}"/>
        </Action>
        <Action ID="RmucMicroSearchSupplyCard" editable="true">
            <inout_port name="search_start_ms" default="{search_start_ms}"/>
            <input_port name="timeout_ms" default="{cfg.search_timeout_ms}"/>
            <input_port name="rfid_status" default="{rfid.status}"/>
        </Action>
        <Condition ID="RmucIsAtNavGoal" editable="true">
            <input_port name="is_at_nav_goal" default="{is_at_nav_goal}"/>
        </Condition>
        <Condition ID="RmucIsSupplyCardDetected" editable="true">
            <input_port name="rfid_status" default="{rfid.status}"/>
        </Condition>

    </TreeNodesModel>

</root>
