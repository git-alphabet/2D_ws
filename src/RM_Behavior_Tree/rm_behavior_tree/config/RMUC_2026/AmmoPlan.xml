<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

    <BehaviorTree ID="AmmoPlan">
        <ReactiveSequence>
            <!-- 默认用 cfg.ammo_low；补弹失败后由插件内部临时切到动态降级阈值 -->
            <IsAmmoBelow ammo_allow="{ammo.allow}" ammo_low="{cfg.ammo_low}"/>

            <ReactiveFallback>
                <!-- If at supply: wait for ammo (30s timeout, retry degradation) -->
                <ReactiveSequence>
                    <IsAtGoal pose_x="{pose.x}" pose_y="{pose.y}"
                              goal_x="{cfg.supply_zone_x}" goal_y="{cfg.supply_zone_y}"
                              arrive_radius="{cfg.arrive_radius}"/>
                    <HoldForSupplyAmmoTick ammo_allow="{ammo.allow}"
                                           timeout_s="{cfg.supply_wait_timeout_s}"
                                           default_threshold="{cfg.ammo_low}"
                                           supply_fail_count="{supply.fail_count}"
                                           supply_next_threshold="{supply.next_threshold}"/>
                </ReactiveSequence>

                <!-- Else: go to supply zone for free ammo -->
                <ReactiveSequence>
                    <SendGoal name="GoSupplyZone"
                              goal_x="{cfg.supply_zone_x}" goal_y="{cfg.supply_zone_y}"
                              frame_id="map" action_name="navigate_to_pose"/>
                    <!-- 底盘旋转由全局 GlobalRobotControl 控制 -->
                    <KeepRunning/>
                </ReactiveSequence>
            </ReactiveFallback>
        </ReactiveSequence>
    </BehaviorTree>

</root>
