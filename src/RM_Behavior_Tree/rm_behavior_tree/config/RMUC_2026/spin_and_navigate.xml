<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="SpinAndNavigate">

    <!--
      简易行为树：原地旋转 + 导航停转
      功能：
        - 在 RViz2 中通过 Nav2 Goal 手动设置导航目标点
        - 导航过程中停止底盘旋转 (chassis_spin = False)
        - 开局停在初始位置时不自转
        - 首次经历导航中状态后，到达第一个非初始导航目标才开始正常旋转逻辑
    -->

    <BehaviorTree ID="SpinAndNavigate">
        <ReactiveSequence>

            <!-- 仅初始化一次：启动时还没有经历过真实导航目标 -->
            <RunOnce then_skip="true">
                <Sequence>
                    <SetBlackboard output_key="has_seen_navigation" value="false"/>
                </Sequence>
            </RunOnce>

            <!-- 持续订阅机器人位置与导航到达状态 -->
            <RmucSubRobotPosition topic_name="robot_position"
                                  pose_x="{pose.x}"
                                  pose_y="{pose.y}"
                                  is_at_nav_goal="{is_at_nav_goal}"/>

            <!-- 底盘旋转控制 -->
            <ReactiveFallback>
                <!-- 正在导航中：记录已经离开初始点并停止旋转 -->
                <ReactiveSequence>
                    <ScriptCondition code="is_at_nav_goal == false"/>
                    <SetBlackboard output_key="has_seen_navigation" value="true"/>
                    <RmucRobotControl stop_gimbal_scan="False"
                                      chassis_spin="False"/>
                    <KeepRunning/>
                </ReactiveSequence>

                <!-- 已经经历过导航，且当前到达目标 / 无活动目标 → 底盘旋转 -->
                <ReactiveSequence>
                    <ScriptCondition code="has_seen_navigation == true"/>
                    <RmucRobotControl stop_gimbal_scan="False"
                                      chassis_spin="True"/>
                    <KeepRunning/>
                </ReactiveSequence>

                <!-- 开局初始位置：还未去过任何非初始导航目标，保持不旋转 -->
                <ReactiveSequence>
                    <RmucRobotControl stop_gimbal_scan="False"
                                      chassis_spin="False"/>
                    <KeepRunning/>
                </ReactiveSequence>
            </ReactiveFallback>

        </ReactiveSequence>
    </BehaviorTree>

</root>
