<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

    <BehaviorTree ID="WeaknessRecovery">
        <ReactiveSequence>
            <IsWeakness robot_status="{robot_status}"/>
            <!-- rush to the nearest dispel card: supply/base/outpost (cannot capture buffs while weak) -->
            <SelectNearestDispelCard pose_x="{pose.x}" pose_y="{pose.y}"
                                     buff_zone_x="{cfg.buff_zone_x}" buff_zone_y="{cfg.buff_zone_y}"
                                     base_buff_x="{cfg.base_buff_x}" base_buff_y="{cfg.base_buff_y}"
                                     outpost_buff_x="{cfg.outpost_buff_x}" outpost_buff_y="{cfg.outpost_buff_y}"
                                     goal_x="{nav.goal_x}" goal_y="{nav.goal_y}"/>
            <RateController hz="1">
                <SendGoal name="DispelWeakness"
                          goal_x="{nav.goal_x}" goal_y="{nav.goal_y}"
                          frame_id="map" action_name="navigate_to_pose"/>
            </RateController>
            <RmucRobotControl stop_gimbal_scan="False"
                              chassis_spin="False"
                              fire_enable="False"/>
            <!-- arrival + micro adjust until any dispel card detected -->
            <ReactiveFallback>
                <IsAnyDispelCardDetected rfid_status="{rfid.status}" robot_status="{robot_status}"/>
                <MoveAround expected_nearby_goal_count="5"
                            expected_dis="0.25"
                            message="{pose}"/>
            </ReactiveFallback>
        </ReactiveSequence>
    </BehaviorTree>

</root>
