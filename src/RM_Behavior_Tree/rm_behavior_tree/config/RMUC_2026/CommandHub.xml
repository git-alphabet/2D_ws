<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

    <BehaviorTree ID="CommandHub">
        <Sequence>
            <!-- 姿态由各战术子树中的 SelectPosture 设置到 {cmd.posture}，
                 SentryCmdMux 仅负责读取并发布 -->

            <!-- Decide respawn confirm (sends 0 when alive, always free respawn) -->
            <DecideRespawnCmd is_dead="{state.is_dead}"
                              confirm_respawn="{cmd.confirm_respawn}"/>

            <!-- 姿态降级守卫：低于基地威胁/补弹/回血，高于普通遇敌及普通目标点 -->
            <PostureDegradationGuard desired_posture="{cmd.posture}"
                                     is_dead="{state.is_dead}"
                                     need_heal_recovery="{need_heal_recovery}"
                                     hp_cur="{hp.cur}"
                                     hp_low="{cfg.hp_low}"
                                     ammo_allow="{ammo.allow}"
                                     ammo_low="{cfg.ammo_low}"
                                     base_threat="{threat.base}"
                                     semantic_zone_active="{semantic.zone_active}"
                                     nav_goal_valid="{nav_goal_valid}"
                                     pose_x="{pose.x}"
                                     pose_y="{pose.y}"
                                     nav_goal_x="{nav.goal_x}"
                                     nav_goal_y="{nav.goal_y}"
                                     fortress_area_x="{cfg.fortress_area_x}"
                                     fortress_area_y="{cfg.fortress_area_y}"
                                     arrive_radius="{cfg.arrive_radius}"
                                     degradation_threshold_s="180"
                                     forced_defense_s="5"
                                     forced_movement_s="5"
                                     final_posture="{cmd.final_posture}"/>

            <SelectSentryCmdRate is_dead="{state.is_dead}"
                                 alive_hz="0.2"
                                 dead_hz="1.0"
                                 hz_out="{cmd.sentry_cmd_hz}"/>

            <RateController hz="{cmd.sentry_cmd_hz}">
                <SentryCmdMux posture="{cmd.final_posture}"
                              confirm_respawn="{cmd.confirm_respawn}"
                              cmd_state="{cmd.state}"/>
            </RateController>
        </Sequence>
    </BehaviorTree>
</root>
