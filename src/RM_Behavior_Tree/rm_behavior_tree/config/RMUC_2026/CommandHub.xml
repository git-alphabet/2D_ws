<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

    <BehaviorTree ID="CommandHub">
        <Sequence>
            <!-- 姿态由各战术子树中的 SelectPosture 设置到 {cmd.posture}，
                 SentryCmdMux 仅负责读取并发布 -->

            <!-- Decide remote exchange & allow-ammo target (monotonic target is maintained inside node) -->
            <DecideEconomyCmd ammo_allow="{ammo.allow}"
                              ammo_target="{cfg.ammo_target}"
                              allow_ammo_max="{cfg.allow_ammo_max}"
                              ammo_increase_interval_ms="{cfg.ammo_increase_interval_ms}"
                              team_coins="{economy.remaining_coins}"
                              allow_ammo_target_in="{cmd.allow_ammo_target}"
                              allow_ammo_target_out="{cmd.allow_ammo_target}"/>

            <!-- Decide respawn confirm / instant respawn request (sends 0 when alive) -->
            <DecideRespawnCmd is_dead="{state.is_dead}"
                              team_coins="{economy.remaining_coins}"
                              stage_remain_time="{game.remain_s}"
                              base_hp_cur="{base.hp.cur}"
                              instant_respawn_cost="{sentry.instant_respawn_cost}"
                              confirm_respawn="{cmd.confirm_respawn}"
                              confirm_instant_respawn="{cmd.confirm_instant_respawn}"/>

            <!-- 姿态降级守卫：累计超过3分钟 → 攻击/移动→强制防御5s, 防御→强制移动10s -->
            <PostureDegradationGuard desired_posture="{cmd.posture}"
                                     degradation_threshold_s="180"
                                     forced_defense_s="5"
                                     forced_movement_s="5"
                                     final_posture="{cmd.final_posture}"/>

            <RateController hz="5">
                <SentryCmdMux posture="{cmd.final_posture}"
                              confirm_respawn="{cmd.confirm_respawn}"
                              confirm_instant_respawn="{cmd.confirm_instant_respawn}"
                              allow_ammo_target="{cmd.allow_ammo_target}"
                              cmd_state="{cmd.state}"/>
            </RateController>
        </Sequence>
    </BehaviorTree>

    <!-- ===== 临时 TreeNodesModel：仅用于 Groot2 独立加载，不影响运行时 ===== -->
    <TreeNodesModel>
        <Action ID="SelectPosture" editable="true">
            <input_port name="posture_value" default="3"/>
            <output_port name="posture_out" default="{cmd.posture}"/>
            <output_port name="is_allow_select_posture"/>
        </Action>
        <Action ID="PostureDegradationGuard" editable="true">
            <input_port name="desired_posture" default="{cmd.posture}"/>
            <input_port name="degradation_threshold_s" default="180"/>
            <input_port name="forced_defense_s" default="5"/>
            <input_port name="forced_movement_s" default="5"/>
            <output_port name="final_posture" default="{cmd.final_posture}"/>
        </Action>
        <Action ID="DecideEconomyCmd" editable="true">
            <input_port name="ammo_allow" default="{ammo.allow}"/>
            <input_port name="ammo_target" default="{cfg.ammo_target}"/>
            <input_port name="allow_ammo_max" default="{cfg.allow_ammo_max}"/>
            <input_port name="ammo_increase_interval_ms" default="{cfg.ammo_increase_interval_ms}"/>
            <input_port name="team_coins" default="{economy.remaining_coins}"/>
            <input_port name="allow_ammo_target_in" default="{cmd.allow_ammo_target}"/>
            <output_port name="allow_ammo_target_out" default="{cmd.allow_ammo_target}"/>
        </Action>
        <Action ID="DecideRespawnCmd" editable="true">
            <input_port name="is_dead" default="{state.is_dead}"/>
            <input_port name="team_coins" default="{economy.remaining_coins}"/>
            <input_port name="stage_remain_time" default="{game.remain_s}"/>
            <input_port name="base_hp_cur" default="{base.hp.cur}"/>
            <input_port name="instant_respawn_cost" default="{sentry.instant_respawn_cost}"/>
            <output_port name="confirm_respawn" default="{cmd.confirm_respawn}"/>
            <output_port name="confirm_instant_respawn" default="{cmd.confirm_instant_respawn}"/>
        </Action>
        <Action ID="SentryCmdMux" editable="true">
            <input_port name="posture" default="3"/>
            <input_port name="confirm_respawn" default="0"/>
            <input_port name="confirm_instant_respawn" default="0"/>
            <input_port name="allow_ammo_target" default="{cmd.allow_ammo_target}"/>
            <inout_port name="cmd_state" default="{cmd.state}"/>
        </Action>
        <Decorator ID="RateController" editable="true">
            <input_port name="hz" default="1.0"/>
        </Decorator>
    </TreeNodesModel>
</root>
