<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

    <BehaviorTree ID="PerceptionAndBlackboard">
        <Sequence>
            <RmucSubGameStatus topic_name="game_status"
                               game_status="{game_status}"
                               now_ms="{time.now_ms}"/>
            <RmucSubRobotStatus topic_name="robot_status"
                                robot_status="{robot_status}"/>
            <RmucSubRobotPosition topic_name="robot_position"
                                  pose_x="{pose.x}"
                                  pose_y="{pose.y}"/>
            <SubRadarTracks topic_name="radar/enemy_tracks"
                            radar_tracks="{radar_tracks}"/>

            <!-- P0 新增: 7 个裁判系统话题订阅 -->
            <RmucSubSentryDecisionStatus topic_name="sentry_decision_status"
                                          sentry_decision_status="{sentry_decision_status}"/>
            <RmucSubRobotBuff topic_name="robot_buff"
                              robot_buff="{robot_buff}"/>
            <RmucSubProjectileAllowance topic_name="projectile_allowance"
                                         projectile_allowance="{projectile_allowance}"/>
            <RmucSubTeamHP topic_name="team_hp"
                           team_hp="{team_hp}"/>

            <!-- Parse/derive common fields used by tactics -->
            <ParseSentryBlackboard game_status="{game_status}"
                                   robot_status="{robot_status}"
                                   defend_anchor_x="{cfg.defend_anchor_x}"
                                   defend_anchor_y="{cfg.defend_anchor_y}"
                                   pose_x="{pose.x}"
                                   pose_y="{pose.y}"
                                   now_ms="{time.now_ms}"
                                   sentry_decision_status="{sentry_decision_status}"
                                   robot_buff="{robot_buff}"
                                   projectile_allowance="{projectile_allowance}"
                                   radar_tracks="{radar_tracks}"
                                   team_hp="{team_hp}"
                                   stage_remain_time="{game.remain_s}"
                                   stage_elapsed_time="{game.elapsed_s}"
                                   hp_cur="{hp.cur}"
                                   heat_cur="{heat.cur}"
                                   ammo_allow="{ammo.allow}"
                                   base_hp_cur="{base.hp.cur}"
                                   base_hp_max="{base.hp.max}"
                                   outpost_alive="{outpost.alive}"
                                   is_dead="{state.is_dead}"
                                   has_target="{combat.has_target}"
                                   base_threat="{threat.base}"
                                   fortress_threat="{threat.fortress}"
                                   can_instant_respawn="{sentry.can_instant_respawn}"
                                   instant_respawn_cost="{sentry.instant_respawn_cost}"
                                   current_posture="{sentry.current_posture}"
                                   exchanged_ammo_total="{sentry.exchanged_ammo_total}"
                                   buff_vulnerability_pct="{buff.vulnerability_pct}"
                                   remaining_coins="{economy.remaining_coins}"
                                   team_outpost_hp="{team.outpost_hp}"
                                   team_base_hp="{team.base_hp}"
                                   is_disengaged="{state.disengaged}"
                                   />
        </Sequence>
    </BehaviorTree>

</root>
