<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

    <BehaviorTree ID="PerceptionAndBlackboard">
        <Sequence>
            <RmucSubGameStatus topic_name="/game_status"
                               game_status="{game_status}"
                               now_ms="{time.now_ms}"/>
            <RmucSubRobotStatus topic_name="/robot_status"
                                robot_status="{robot_status}"/>
            <RmucSubRFIDStatus topic_name="/rfid_status"
                               rfid_status="{rfid.status}"/>
            <RmucSubRobotPosition topic_name="/robot_position"
                                  pose_x="{pose.x}"
                                  pose_y="{pose.y}"
                                  pose_yaw="{pose.yaw}"
                                  is_at_nav_goal="{is_at_nav_goal}"
                                  pose="{pose}"/>

            <!-- P0 新增: 7 个裁判系统话题订阅 -->
            <RmucSubSentryDecisionStatus topic_name="/sentry_decision_status"
                                          sentry_decision_status="{sentry_decision_status}"/>
            <RmucSubRobotBuff topic_name="/robot_buff"
                              robot_buff="{robot_buff}"/>
            <RmucSubProjectileAllowance topic_name="/projectile_allowance"
                                         projectile_allowance="{projectile_allowance}"/>
            <RmucSubFieldStatus topic_name="/field_status"
                                field_status="{field_status}"/>
            <RmucSubEnemyMark topic_name="/enemy_mark"
                              enemy_mark="{enemy_mark}"/>
            <RmucSubTeamPositions topic_name="/team_positions"
                                  team_positions="{team_positions}"/>
            <RmucSubTeamHP topic_name="/team_hp"
                           team_hp="{team_hp}"/>

            <!-- Parse/derive common fields used by tactics -->
            <ParseSentryBlackboard game_status="{game_status}"
                                   robot_status="{robot_status}"
                                   pose_x="{pose.x}"
                                   pose_y="{pose.y}"
                                   now_ms="{time.now_ms}"
                                   sentry_decision_status="{sentry_decision_status}"
                                   robot_buff="{robot_buff}"
                                   projectile_allowance="{projectile_allowance}"
                                   field_status="{field_status}"
                                   enemy_mark="{enemy_mark}"
                                   team_positions="{team_positions}"
                                   team_hp="{team_hp}"
                                   stage_remain_time="{game.remain_s}"
                                   stage_elapsed_time="{game.elapsed_s}"
                                   hp_cur="{hp.cur}"
                                   hp_max="{hp.max}"
                                   heat_cur="{heat.cur}"
                                   ammo_allow="{ammo.allow}"
                                   ammo_left="{ammo.left}"
                                   base_hp_cur="{base.hp.cur}"
                                   base_hp_max="{base.hp.max}"
                                   outpost_alive="{outpost.alive}"
                                   is_dead="{state.is_dead}"
                                   can_remote_heal="{economy.can_remote_heal}"
                                   can_remote_ammo="{economy.can_remote_ammo}"
                                   team_coins="{economy.coins}"
                                   has_target="{combat.has_target}"
                                   base_threat="{threat.base}"
                                   fortress_threat="{threat.fortress}"
                                   can_free_respawn="{sentry.can_free_respawn}"
                                   can_instant_respawn="{sentry.can_instant_respawn}"
                                   instant_respawn_cost="{sentry.instant_respawn_cost}"
                                   current_posture="{sentry.current_posture}"
                                   remote_ammo_count="{sentry.remote_ammo_count}"
                                   remote_heal_count="{sentry.remote_heal_count}"
                                   exchanged_ammo_total="{sentry.exchanged_ammo_total}"
                                   can_activate_energy="{sentry.can_activate_energy}"
                                   buff_heal_rate="{buff.heal_rate}"
                                   buff_cool_value="{buff.cool_value}"
                                   buff_defense_pct="{buff.defense_pct}"
                                   buff_vulnerability_pct="{buff.vulnerability_pct}"
                                   buff_attack_pct="{buff.attack_pct}"
                                   fortress_ammo="{economy.fortress_ammo}"
                                   field_central_highland="{field.central_highland}"
                                   field_ladder_highland="{field.ladder_highland}"
                                   field_fortress="{field.fortress}"
                                   field_outpost_buff="{field.outpost_buff}"
                                   field_base_buff="{field.base_buff}"
                                   field_small_energy="{field.small_energy}"
                                   field_big_energy="{field.big_energy}"
                                   enemy_hero_vuln="{enemy.hero_vuln}"
                                   enemy_engi_vuln="{enemy.engi_vuln}"
                                   enemy_infantry3_vuln="{enemy.infantry3_vuln}"
                                   enemy_infantry4_vuln="{enemy.infantry4_vuln}"
                                   enemy_sentry_vuln="{enemy.sentry_vuln}"
                                   team_outpost_hp="{team.outpost_hp}"
                                   team_base_hp="{team.base_hp}"
                                   is_respawn_invincible="{state.respawn_invincible}"
                                   respawn_invincible_remain_s="{state.respawn_invincible_remain_s}"
                                   is_power_boosted="{state.power_boosted}"
                                   power_boost_remain_s="{state.power_boost_remain_s}"
                                   cumulative_instant_count="{respawn.cum_instant_count}"/>
        </Sequence>
    </BehaviorTree>

</root>
