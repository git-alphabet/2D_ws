<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

    <BehaviorTree ID="SustainAndEconomy">
        <ReactiveSequence>
            <!-- 低弹补给：路上强制移动；到补给区后强制防御并等待补弹 -->
            <IsAmmoBelow ammo_allow="{ammo.allow}" ammo_low="{cfg.ammo_low}"/>

            <ReactiveFallback>
                <!-- 已到补给区：防御姿态等待补弹/超时降级 -->
                <ReactiveSequence>
                    <IsAtGoal pose_x="{pose.x}" pose_y="{pose.y}"
                              goal_x="{cfg.supply_zone_x}" goal_y="{cfg.supply_zone_y}"
                              arrive_radius="{cfg.arrive_radius}"/>
                    <ReactiveFallback>
                        <Sequence>
                            <ScriptCondition code="energy_saving_mode_enable == true"/>
                            <SelectPosture posture_value="1"
                                           posture_out="{cmd.posture}"
                                           is_allow_select_posture="{cmd.allow_posture_send}"/>
                        </Sequence>
                        <SelectPosture posture_value="2"
                                       posture_out="{cmd.posture}"
                                       is_allow_select_posture="{cmd.allow_posture_send}"/>
                    </ReactiveFallback>
                    <HoldForSupplyAmmoTick ammo_allow="{ammo.allow}"
                                           timeout_s="{cfg.supply_wait_timeout_s}"
                                           default_threshold="{cfg.ammo_low}"
                                           supply_fail_count="{supply.fail_count}"
                                           supply_next_threshold="{supply.next_threshold}"/>
                </ReactiveSequence>

                <!-- 未到补给区：移动姿态前往补给区，普通敌情不会打断 -->
                <ReactiveSequence>
                    <SelectPosture posture_value="3"
                                   posture_out="{cmd.posture}"
                                   is_allow_select_posture="{cmd.allow_posture_send}"/>
                    <SendGoal name="GoSupplyZone"
                              goal_x="{cfg.supply_zone_x}" goal_y="{cfg.supply_zone_y}"
                              frame_id="map" action_name="navigate_to_pose"/>
                    <KeepRunning/>
                </ReactiveSequence>
            </ReactiveFallback>
        </ReactiveSequence>
    </BehaviorTree>

</root>
