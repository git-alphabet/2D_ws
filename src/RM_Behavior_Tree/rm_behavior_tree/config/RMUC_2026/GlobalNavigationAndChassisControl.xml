<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

    <BehaviorTree ID="GlobalNavigationAndChassisControl">
        <!--
            上层全局接管控制：
            1. 先持续发布底盘/云台控制（表现层）
            2. 再做生存门禁（低血/死亡接管）
            3. 再做敌情门禁（见敌阻塞）

            使用 ReactiveSequence，确保后两个门禁返回 RUNNING 时，
            第一段 ChassisControlLayer 仍会在每 tick 重新执行。
        -->
        <ReactiveSequence>

            <!-- 全局底盘/云台控制：基于条件，与战术子树解耦 -->
            <ReactiveFallback name="ChassisControlLayer">
                <!-- 死亡 → 停云台，不旋转 -->
                <Sequence>
                    <RmucIsDead message="{robot_status}"/>
                    <RmucRobotControl stop_gimbal_scan="True"
                                      chassis_spin="False"/>
                </Sequence>
                <!-- 在补给区 → 不旋转（安全区域，回血/补弹中） -->
                <Sequence>
                    <IsAtGoal pose_x="{pose.x}" pose_y="{pose.y}"
                              goal_x="{cfg.supply_zone_x}" goal_y="{cfg.supply_zone_y}"
                              arrive_radius="{cfg.arrive_radius}"/>
                    <RmucRobotControl stop_gimbal_scan="False"
                                      chassis_spin="False"/>
                </Sequence>
                <!-- 基地威胁且已到防御锚点 → 持续自转 -->
                <Sequence>
                    <IsBaseThreatened base_threat="{threat.base}"/>
                    <IsAtGoal pose_x="{pose.x}" pose_y="{pose.y}"
                              goal_x="{cfg.defend_anchor_x}" goal_y="{cfg.defend_anchor_y}"
                              arrive_radius="{cfg.arrive_radius}"/>
                    <RmucRobotControl stop_gimbal_scan="False"
                                      chassis_spin="True"/>
                </Sequence>
                <!-- 到达当前导航目标 → 旋转 -->
                <Sequence>
                    <IsAtGoal pose_x="{pose.x}" pose_y="{pose.y}"
                              goal_x="{nav.goal_x}" goal_y="{nav.goal_y}"
                              arrive_radius="{cfg.arrive_radius}"/>
                    <RmucRobotControl stop_gimbal_scan="False"
                                      chassis_spin="True"/>
                </Sequence>
                <!-- 默认（导航中等） → 不旋转 -->
                <RmucRobotControl stop_gimbal_scan="False"
                                  chassis_spin="False"/>
            </ReactiveFallback>

            <!-- 生存优先：死亡/低血量回补给区 -->
            <ReactiveFallback name="SurvivalGuard">
                <!-- HP 正常且未死亡 → SUCCESS，放行 -->
                <Sequence>
                    <Inverter>
                        <RmucIsDead message="{robot_status}"/>
                    </Inverter>
                    <Inverter>
                        <RmucIsHPBelow message="{robot_status}" hp_threshold="{cfg.hp_low}"/>
                    </Inverter>
                </Sequence>
                <!-- 死亡或低血量 → LowHPRetreat 接管（返回 RUNNING 阻塞后续） -->
                <Sequence>
                    <SetBlackboard output_key="active_subtree" value="LowHPRetreat"/>
                    <SubTree ID="LowHPRetreat" _autoremap="true"/>
                </Sequence>
            </ReactiveFallback>

            <!-- 敌情门禁：检测到敌人 → 取消导航、原地停车，阻塞后续战术 -->
            <ReactiveFallback name="EnemyDetectionGuard">
                <!-- 基地威胁模式 → 放行，优先回基地防御锚点，不受普通见敌阻塞打断 -->
                <IsBaseThreatened base_threat="{threat.base}"/>
                <!-- 无敌人 → 放行 -->
                <Inverter>
                    <RmucIsDetectEnemy message="{robot_status}"
                                       is_detect_enemy="{is_detect_enemy}"/>
                </Inverter>
                <!-- 当前 Nav2 目标 = 补给区 → 放行（无视敌人，继续导航回家） -->
                <IsNavTargetSupply goal_x="{cfg.supply_zone_x}" goal_y="{cfg.supply_zone_y}"
                                   arrive_radius="{cfg.arrive_radius}"/>
                <!-- 有敌人 + 目标不是补给区 → 切攻击姿态 + 取消导航 + 开启旋转 + 阻塞 -->
                <Sequence>
                    <SetBlackboard output_key="active_subtree" value="EnemyHold"/>
                    <SelectPosture posture_value="1"
                                   posture_out="{cmd.posture}"
                                   is_allow_select_posture="{cmd.allow_posture_send}"/>
                    <CancelNavGoal action_name="navigate_to_pose"/>
                    <RmucRobotControl stop_gimbal_scan="False"
                                      chassis_spin="True"/>
                    <RmucNavControlCmd cmd_type="3" emergency_stop="False"/>
                    <KeepRunning/>
                </Sequence>
            </ReactiveFallback>

        </ReactiveSequence>
    </BehaviorTree>

</root>
