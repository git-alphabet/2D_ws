<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

    <BehaviorTree ID="GlobalNavigationAndChassisControl">
        <!--
            上层全局接管控制：
            1. 先持续发布底盘/云台控制（表现层）
            2. 再做生存门禁（低血/死亡接管）
            3. 再做敌情门禁（见敌阻塞）

            使用 ReactiveSequence，确保后两个门禁返回 RUNNING 时，
            第一段 ChassisControlLayer 仍会在每 tick 重新执行。
        -->
        <ReactiveSequence>

            <!-- 低血恢复锁存：先更新状态，供下面唯一的底盘控制出口使用 -->
            <UpdateHealRecoveryLatch hp_cur="{hp.cur}"
                                     hp_low="{cfg.hp_low}"
                                     hp_safe="{cfg.hp_safe}"
                                     need_heal_recovery="{need_heal_recovery}"/>

            <!-- 全局底盘/云台控制：基于条件，与战术子树解耦 -->
            <ReactiveFallback name="ChassisControlLayer">
                <!-- 死亡 → 停云台，不旋转 -->
                <Sequence>
                    <RmucIsDead message="{robot_status}"/>
                    <RmucRobotControl stop_gimbal_scan="True"
                                      chassis_spin="False"/>
                </Sequence>

                <!-- 回补给/补弹/当前目标为补给区 → 不旋转，优先级高于普通遇敌 -->
                <Sequence>
                    <ScriptCondition code="need_heal_recovery == true"/>
                    <RmucRobotControl stop_gimbal_scan="False"
                                      chassis_spin="False"/>
                </Sequence>
                <Sequence>
                    <IsAmmoBelow ammo_allow="{ammo.allow}" ammo_low="{cfg.ammo_low}"/>
                    <RmucRobotControl stop_gimbal_scan="False"
                                      chassis_spin="False"/>
                </Sequence>
                <Sequence>
                    <IsNavTargetSupply goal_x="{cfg.supply_zone_x}" goal_y="{cfg.supply_zone_y}"
                                       arrive_radius="{cfg.arrive_radius}"/>
                    <RmucRobotControl stop_gimbal_scan="False"
                                      chassis_spin="False"/>
                </Sequence>
                <Sequence>
                    <IsAtGoal pose_x="{pose.x}" pose_y="{pose.y}"
                              goal_x="{cfg.supply_zone_x}" goal_y="{cfg.supply_zone_y}"
                              arrive_radius="{cfg.arrive_radius}"/>
                    <RmucRobotControl stop_gimbal_scan="False"
                                      chassis_spin="False"/>
                </Sequence>

                <!-- 基地威胁优先于普通遇敌；到达防御锚点后持续自转，路上不转 -->
                <Sequence>
                    <IsBaseThreatened base_threat="{threat.base}"/>
                    <IsAtGoal pose_x="{pose.x}" pose_y="{pose.y}"
                              goal_x="{cfg.defend_anchor_x}" goal_y="{cfg.defend_anchor_y}"
                              arrive_radius="{cfg.arrive_radius}"/>
                    <RmucRobotControl stop_gimbal_scan="False"
                                      chassis_spin="True"/>
                </Sequence>
                <Sequence>
                    <IsBaseThreatened base_threat="{threat.base}"/>
                    <RmucRobotControl stop_gimbal_scan="False"
                                      chassis_spin="False"/>
                </Sequence>

                <!-- 普通遇敌：低于基地威胁/回补给，高于其他导航到点状态 -->
                <Sequence>
                    <RmucIsDetectEnemy message="{robot_status}"
                                       is_detect_enemy="{is_detect_enemy}"/>
                    <RmucRobotControl stop_gimbal_scan="False"
                                      chassis_spin="True"/>
                </Sequence>

                <!-- 到达当前导航目标 → 旋转 -->
                <Sequence>
                    <IsAtGoal pose_x="{pose.x}" pose_y="{pose.y}"
                              goal_x="{nav.goal_x}" goal_y="{nav.goal_y}"
                              arrive_radius="{cfg.arrive_radius}"/>
                    <RmucRobotControl stop_gimbal_scan="False"
                                      chassis_spin="True"/>
                </Sequence>
                <!-- 默认（导航中等） → 不旋转 -->
                <RmucRobotControl stop_gimbal_scan="False"
                                  chassis_spin="False"/>
            </ReactiveFallback>

            <!-- 生存优先：死亡/低血量回补给区 -->
            <ReactiveFallback name="SurvivalGuard">
                <!-- 未死亡且未处于回血恢复锁存态 → SUCCESS，放行 -->
                <Sequence>
                    <Inverter>
                        <RmucIsDead message="{robot_status}"/>
                    </Inverter>
                    <ScriptCondition code="need_heal_recovery == false"/>
                </Sequence>
                <!-- 死亡或处于回血恢复锁存态 → LowHPRetreat 接管（返回 RUNNING 阻塞后续） -->
                <Sequence>
                    <SetBlackboard output_key="active_subtree" value="LowHPRetreat"/>
                    <SubTree ID="LowHPRetreat" _autoremap="true"/>
                </Sequence>
            </ReactiveFallback>

            <!-- 敌情门禁：检测到敌人 → 取消导航、原地停车，阻塞后续战术 -->
            <ReactiveFallback name="EnemyDetectionGuard">
                <!-- 低弹补给优先级高于普通见敌，放行给 SustainAndEconomy 接管 -->
                <IsAmmoBelow ammo_allow="{ammo.allow}" ammo_low="{cfg.ammo_low}"/>
                <!-- 基地威胁模式 → 放行，优先回基地防御锚点，不受普通见敌阻塞打断 -->
                <IsBaseThreatened base_threat="{threat.base}"/>
                <!-- robot_buff 易伤防御分支暂停接入：恢复时取消注释即可。
                <Sequence>
                    <SetBlackboard output_key="active_subtree" value="VulnerableDefense"/>
                    <IsVulnerable robot_buff="{robot_buff}"/>
                    <SelectPosture posture_value="2"
                                   posture_out="{cmd.posture}"
                                   is_allow_select_posture="{cmd.allow_posture_send}"/>
                    <KeepRunning/>
                </Sequence>
                -->
                <!-- 无敌人 → 放行 -->
                <Inverter>
                    <RmucIsDetectEnemy message="{robot_status}"
                                       is_detect_enemy="{is_detect_enemy}"/>
                </Inverter>
                <!-- 当前 Nav2 目标 = 补给区 → 放行（无视敌人，继续导航回家） -->
                <IsNavTargetSupply goal_x="{cfg.supply_zone_x}" goal_y="{cfg.supply_zone_y}"
                                   arrive_radius="{cfg.arrive_radius}"/>
                <!-- 有敌人 + 目标不是补给区 → 切攻击姿态 + 取消导航 + 阻塞；底盘控制由 ChassisControlLayer 唯一发布 -->
                <Sequence>
                    <SetBlackboard output_key="active_subtree" value="EnemyHold"/>
                    <SelectPosture posture_value="1"
                                   posture_out="{cmd.posture}"
                                   is_allow_select_posture="{cmd.allow_posture_send}"/>
                    <CancelNavGoal action_name="navigate_to_pose"/>
                    <KeepRunning/>
                </Sequence>
            </ReactiveFallback>

        </ReactiveSequence>
    </BehaviorTree>

</root>
