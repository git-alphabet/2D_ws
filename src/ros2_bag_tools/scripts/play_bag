#!/usr/bin/env python3

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog="play_bag",
        description="ros2 bag 回放（默认先 info，再带 --clock）。",
    )
    parser.add_argument("bag_dir", help="bag 目录路径")
    parser.add_argument("--rate", default="1.0", help="回放倍率（默认 1.0）")
    parser.add_argument("--loop", action="store_true", help="循环回放")
    parser.add_argument("--no-clock", action="store_true", help="不发布 /clock")
    parser.add_argument(
        "--exclude-topics", nargs="*", default=[],
        help="回放时排除这些话题（避免和程序发布者冲突）",
    )
    args = parser.parse_args(argv)

    if shutil.which("ros2") is None:
        print(
            "找不到 ros2 命令。请先 source ROS2 环境以及工作空间 install/setup.bash",
            file=sys.stderr,
        )
        return 1

    bag_dir = Path(args.bag_dir).expanduser()
    if not bag_dir.is_dir() and not bag_dir.is_absolute():
        # 兼容在工作空间根目录下只传时间戳目录名的用法
        candidate = Path("bags") / bag_dir
        if candidate.is_dir():
            bag_dir = candidate

    if not bag_dir.is_dir():
        print(f"bag 目录不存在: {bag_dir}", file=sys.stderr)
        print("提示：可尝试传入 bags/<bag目录名>，例如 bags/2026-03-27_18-40-09", file=sys.stderr)
        return 1

    metadata_file = bag_dir / "metadata.yaml"
    if not metadata_file.is_file():
        print("检测到 metadata.yaml 缺失，尝试自动重建...", file=sys.stderr)
        empty_segments = [p for p in sorted(bag_dir.glob("*.db3")) if p.stat().st_size == 0]
        for seg in empty_segments:
            skipped = seg.with_suffix(seg.suffix + ".skip")
            seg.rename(skipped)
            print(f"检测到空分片，已临时跳过: {seg.name} -> {skipped.name}", file=sys.stderr)

        rc = subprocess.run(["ros2", "bag", "reindex", str(bag_dir)], check=False).returncode
        if rc != 0 or not metadata_file.is_file():
            print("重建 metadata 失败，请确认该目录是有效的 rosbag2 目录。", file=sys.stderr)
            if empty_segments:
                print("提示：目录里存在 0 字节 .db3 分片，可能是录包中断导致。", file=sys.stderr)
            return 1

    print("bag 信息：")
    try:
        subprocess.run(["ros2", "bag", "info", str(bag_dir)], check=False)
    except Exception:
        pass

    cmd: list[str] = ["ros2", "bag", "play", str(bag_dir), "--rate", str(args.rate)]
    if not args.no_clock:
        cmd.append("--clock")
    if args.loop:
        cmd.append("--loop")

    if args.exclude_topics:
        exclude_set = set(args.exclude_topics)
        # Read topics from metadata.yaml
        import yaml
        meta = yaml.safe_load((bag_dir / "metadata.yaml").read_text())
        all_topics = [
            t["topic_metadata"]["name"]
            for t in meta.get("rosbag2_bagfile_information", {}).get("topics_with_message_count", [])
        ]
        play_topics = [t for t in all_topics if t not in exclude_set]
        if not play_topics:
            print("排除后没有剩余话题可回放", file=sys.stderr)
            return 1
        print(f"排除话题: {sorted(exclude_set)}")
        print(f"回放话题: {play_topics}")
        cmd.append("--topics")
        cmd.extend(play_topics)

    print("开始回放...")
    os.execvp(cmd[0], cmd)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
