[Unit]
Description=Restart selected Docker containers after GDM3 login
After=docker.service network-online.target graphical-session.target
Wants=docker.service network-online.target
ConditionPathExists=/var/run/docker.sock

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/gxu2026-docker-restart
ExecStartPre=/bin/sleep 1
ExecStart=/usr/local/sbin/gxu2026-docker-restart
